<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="campanhas-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="campanhas-hero">

        <div class="container campanhas-hero-grid">

            <div class="campanhas-hero-conteudo">

                <span class="secao-etiqueta">
                    NOSSAS AÇÕES
                </span>

                <h1>
                    Campanhas que transformam
                    <span>solidariedade em ação</span>
                </h1>

                <p>
                    Conheça as iniciativas realizadas pelo
                    Instituto Solidarize e descubra como sua
                    contribuição pode ajudar pessoas e famílias
                    da nossa comunidade.
                </p>

                <a
                    href="#campanhas-ativas"
                    class="btn-principal"
                >
                    Ver campanhas ativas
                </a>

            </div>


            <div class="campanhas-hero-destaque">

                <span class="campanhas-hero-etiqueta">
                    PARTICIPE
                </span>

                <h2>
                    Cada contribuição aproxima uma campanha da sua meta
                </h2>

                <p>
                    Escolha uma ação, acompanhe o progresso
                    da arrecadação e contribua diretamente
                    pelo site.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CAMPANHAS ATIVAS
    ====================================================== -->

    <section
        class="campanhas-publicas campanhas-publicas-nova"
        id="campanhas-ativas"
    >

        <div class="container">

            <div class="campanhas-cabecalho campanhas-cabecalho-novo">

                <div>

                    <span class="secao-etiqueta">
                        CAMPANHAS ATIVAS
                    </span>

                    <h2>
                        Faça parte das nossas ações
                    </h2>

                    <p>
                        Cada campanha representa uma oportunidade
                        de contribuir e gerar impacto positivo
                        na comunidade.
                    </p>

                </div>

            </div>


            <% if (!campanhas || campanhas.length === 0) { %>

                <div class="campanhas-vazio">

                    <span class="secao-etiqueta">
                        EM BREVE
                    </span>

                    <h3>
                        Nenhuma campanha ativa no momento
                    </h3>

                    <p>
                        Novas campanhas serão divulgadas aqui.
                        Acompanhe o Instituto Solidarize para
                        conhecer nossas próximas ações.
                    </p>

                    <a
                        href="/como-ajudar"
                        class="btn-principal"
                    >
                        Veja como ajudar
                    </a>

                </div>

            <% } else { %>

                <div class="campanhas-carrossel-area">


                    <!-- BARRA DO CARROSSEL -->

                    <div class="campanhas-carrossel-barra">

                        <div class="campanhas-indicador-area">

                            <span class="campanhas-indicador-label">
                                CAMPANHA
                            </span>

                            <strong id="campanha-indicador">
                                1 de <%= campanhas.length %>
                            </strong>

                        </div>


                        <div class="campanhas-carrossel-controles">

                            <button
                                type="button"
                                id="campanha-anterior"
                                class="btn-secundario carrossel-btn"
                            >
                                Anterior
                            </button>


                            <button
                                type="button"
                                id="campanha-proxima"
                                class="btn-principal carrossel-btn"
                            >
                                Próxima
                            </button>

                        </div>

                    </div>


                    <!-- CARROSSEL -->

                    <div
                        class="campanhas-carrossel"
                        id="campanhas-carrossel"
                    >

                        <% campanhas.forEach(campanha => { %>

                            <%
                                const meta =
                                    Number(campanha.meta) || 0;

                                const arrecadado =
                                    Number(campanha.valor_arrecadado) || 0;

                                const percentual =
                                    meta > 0
                                        ? (arrecadado / meta) * 100
                                        : 0;

                                const percentualExibido =
                                    Math.round(percentual);

                                const larguraBarra =
                                    Math.min(percentual, 100);
                            %>


                            <article class="campanha-slide-card">


                                <!-- IMAGEM -->

                                <div class="campanha-slide-imagem">

                                    <% if (campanha.imagem) { %>

                                        <img
                                            src="/images/campanhas/<%= campanha.imagem %>"
                                            alt="Imagem da campanha <%= campanha.titulo %>"
                                            loading="lazy"
                                        >

                                    <% } else { %>

                                        <div class="campanha-slide-sem-imagem">

                                            <span>
                                                Instituto Solidarize
                                            </span>

                                            <strong>
                                                Solidariedade em ação
                                            </strong>

                                        </div>

                                    <% } %>

                                </div>


                                <!-- CONTEÚDO -->

                                <div class="campanha-slide-conteudo">


                                    <div class="campanha-card-topo">

                                        <span class="campanha-status">
                                            <%= campanha.status %>
                                        </span>

                                        <span class="campanha-id">
                                            Campanha #<%= campanha.id %>
                                        </span>

                                    </div>


                                    <h3>
                                        <%= campanha.titulo %>
                                    </h3>


                                    <p class="campanha-descricao">
                                        <%= campanha.descricao %>
                                    </p>


                                    <!-- DATAS E META -->

                                    <div class="campanha-informacoes">

                                        <div>

                                            <span>
                                                Início
                                            </span>

                                            <strong>
                                                <%= new Date(
                                                    campanha.data_inicio
                                                ).toLocaleDateString('pt-BR') %>
                                            </strong>

                                        </div>


                                        <div>

                                            <span>
                                                Término
                                            </span>

                                            <strong>

                                                <% if (campanha.data_fim) { %>

                                                    <%= new Date(
                                                        campanha.data_fim
                                                    ).toLocaleDateString('pt-BR') %>

                                                <% } else { %>

                                                    Não definido

                                                <% } %>

                                            </strong>

                                        </div>


                                        <div>

                                            <span>
                                                Meta
                                            </span>

                                            <strong>

                                                <% if (meta > 0) { %>

                                                    R$
                                                    <%= meta
                                                        .toFixed(2)
                                                        .replace('.', ',') %>

                                                <% } else { %>

                                                    Não definida

                                                <% } %>

                                            </strong>

                                        </div>

                                    </div>


                                    <!-- ARRECADAÇÃO -->

                                    <div class="campanha-arrecadacao">

                                        <div class="campanha-arrecadacao-topo">

                                            <span>
                                                Arrecadado
                                            </span>

                                            <strong>

                                                R$
                                                <%= arrecadado
                                                    .toFixed(2)
                                                    .replace('.', ',') %>

                                            </strong>

                                        </div>


                                        <% if (meta > 0) { %>

                                            <div
                                                class="campanha-progresso"
                                                role="progressbar"
                                                aria-label="Progresso da arrecadação"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                                aria-valuenow="<%= Math.min(
                                                    percentualExibido,
                                                    100
                                                ) %>"
                                            >

                                                <div
                                                    class="campanha-progresso-preenchimento"
                                                    style="width: <%= larguraBarra %>%"
                                                ></div>

                                            </div>


                                            <div class="campanha-progresso-dados">

                                                <span>

                                                    R$
                                                    <%= arrecadado
                                                        .toFixed(2)
                                                        .replace('.', ',') %>

                                                    de R$
                                                    <%= meta
                                                        .toFixed(2)
                                                        .replace('.', ',') %>

                                                </span>

                                                <strong>
                                                    <%= percentualExibido %>%
                                                </strong>

                                            </div>

                                        <% } else { %>

                                            <p class="campanha-sem-meta">
                                                Esta campanha não possui
                                                uma meta financeira definida.
                                            </p>

                                        <% } %>

                                    </div>


                                    <!-- AÇÃO -->

                                    <div class="campanha-slide-acao">

                                        <a
                                            href="/doar/<%= campanha.id %>"
                                            class="btn-principal"
                                        >
                                            Quero ajudar
                                        </a>

                                    </div>

                                </div>

                            </article>

                        <% }) %>

                    </div>

                </div>

            <% } %>

        </div>

    </section>


    <!-- =====================================================
         OUTRAS FORMAS DE PARTICIPAR
    ====================================================== -->

    <section class="campanhas-participacao">

        <div class="container campanhas-participacao-grid">

            <div>

                <span class="secao-etiqueta">
                    ALÉM DAS DOAÇÕES
                </span>

                <h2>
                    Existem outras formas de fazer parte
                </h2>

                <p>
                    Você também pode contribuir oferecendo seu tempo,
                    participando de ações ou ajudando nossas campanhas
                    a chegarem a mais pessoas.
                </p>

            </div>


            <div class="campanhas-participacao-opcoes">

                <a
                    href="/quero-ser-voluntario"
                    class="campanhas-participacao-item"
                >

                    <span>
                        01
                    </span>

                    <div>

                        <h3>
                            Seja voluntário
                        </h3>

                        <p>
                            Participe diretamente das ações
                            realizadas pelo Instituto.
                        </p>

                    </div>

                </a>


                <a
                    href="/como-ajudar"
                    class="campanhas-participacao-item"
                >

                    <span>
                        02
                    </span>

                    <div>

                        <h3>
                            Conheça outras formas de ajudar
                        </h3>

                        <p>
                            Descubra diferentes maneiras
                            de apoiar o Solidarize.
                        </p>

                    </div>

                </a>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CHAMADA FINAL
    ====================================================== -->

    <section class="home-cta">

        <div class="container">

            <div class="home-cta-box">

                <span class="secao-etiqueta">
                    PARTICIPE
                </span>

                <h2>
                    Sua contribuição faz diferença
                </h2>

                <p>
                    Apoie uma campanha, participe como voluntário
                    ou ajude divulgando as ações do Instituto.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/como-ajudar"
                        class="btn-principal"
                    >
                        Como ajudar
                    </a>

                    <a
                        href="/quero-ser-voluntario"
                        class="btn-secundario"
                    >
                        Seja voluntário
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>


<!-- =========================================================
     CARROSSEL
========================================================= -->

<script>

document.addEventListener(
    'DOMContentLoaded',
    () => {

        const carrossel =
            document.getElementById(
                'campanhas-carrossel'
            );

        const anterior =
            document.getElementById(
                'campanha-anterior'
            );

        const proxima =
            document.getElementById(
                'campanha-proxima'
            );

        const indicador =
            document.getElementById(
                'campanha-indicador'
            );


        if (
            !carrossel ||
            !anterior ||
            !proxima ||
            !indicador
        ) {
            return;
        }


        const slides =
            carrossel.querySelectorAll(
                '.campanha-slide-card'
            );


        let indiceAtual = 0;


        function atualizarCarrossel() {

            const largura =
                carrossel.clientWidth;


            carrossel.scrollTo({

                left:
                    largura * indiceAtual,

                behavior:
                    'smooth'

            });


            indicador.textContent =
                `${indiceAtual + 1} de ${slides.length}`;


            anterior.disabled =
                indiceAtual === 0;


            proxima.disabled =
                indiceAtual ===
                slides.length - 1;

        }


        anterior.addEventListener(
            'click',
            () => {

                if (indiceAtual > 0) {

                    indiceAtual--;

                    atualizarCarrossel();

                }

            }
        );


        proxima.addEventListener(
            'click',
            () => {

                if (
                    indiceAtual <
                    slides.length - 1
                ) {

                    indiceAtual++;

                    atualizarCarrossel();

                }

            }
        );


        carrossel.addEventListener(
            'scroll',
            () => {

                if (!carrossel.clientWidth) {
                    return;
                }


                const novoIndice =
                    Math.round(
                        carrossel.scrollLeft /
                        carrossel.clientWidth
                    );


                if (
                    novoIndice >= 0 &&
                    novoIndice < slides.length
                ) {

                    indiceAtual =
                        novoIndice;


                    indicador.textContent =
                        `${indiceAtual + 1} de ${slides.length}`;


                    anterior.disabled =
                        indiceAtual === 0;


                    proxima.disabled =
                        indiceAtual ===
                        slides.length - 1;

                }

            }
        );


        window.addEventListener(
            'resize',
            () => {

                carrossel.scrollTo({

                    left:
                        carrossel.clientWidth *
                        indiceAtual

                });

            }
        );


        atualizarCarrossel();

    }
);

</script>


<%- include('partials/footer') %>