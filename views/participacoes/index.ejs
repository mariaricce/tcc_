<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo admin-conteudo-novo">

        <%
            const listaParticipacoes =
                participacoes || [];

            const totalParticipacoes =
                listaParticipacoes.length;

            const totalInscritos =
                listaParticipacoes.filter(
                    participacao =>
                        participacao.status === 'Inscrito'
                ).length;

            const totalParticipando =
                listaParticipacoes.filter(
                    participacao =>
                        participacao.status === 'Participando'
                ).length;

            const totalConcluidos =
                listaParticipacoes.filter(
                    participacao =>
                        participacao.status === 'Concluido'
                ).length;

            const totalCancelados =
                listaParticipacoes.filter(
                    participacao =>
                        participacao.status === 'Cancelado'
                ).length;
        %>


        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <header class="admin-listagem-topo">

            <div>

                <span class="secao-etiqueta">
                    GERENCIAMENTO
                </span>

                <h1>
                    Participações
                </h1>

                <p>
                    Gerencie a participação dos voluntários
                    nas campanhas do Instituto Solidarize.
                </p>

            </div>


            <a
                href="/admin/participacoes/nova"
                class="btn-principal"
            >
                Nova participação
            </a>

        </header>


        <!-- =====================================================
             RESUMO
        ====================================================== -->

        <section class="participacoes-admin-resumo">

            <div class="participacoes-admin-resumo-card">

                <span>
                    TOTAL
                </span>

                <strong>
                    <%= totalParticipacoes %>
                </strong>

                <p>
                    Participações cadastradas
                </p>

            </div>


            <div class="participacoes-admin-resumo-card">

                <span>
                    INSCRITOS
                </span>

                <strong>
                    <%= totalInscritos %>
                </strong>

                <p>
                    Aguardando participação
                </p>

            </div>


            <div class="participacoes-admin-resumo-card">

                <span>
                    PARTICIPANDO
                </span>

                <strong>
                    <%= totalParticipando %>
                </strong>

                <p>
                    Participações em andamento
                </p>

            </div>


            <div class="participacoes-admin-resumo-card">

                <span>
                    CONCLUÍDOS
                </span>

                <strong>
                    <%= totalConcluidos %>
                </strong>

                <p>
                    Participações finalizadas
                </p>

            </div>


            <div class="participacoes-admin-resumo-card">

                <span>
                    CANCELADOS
                </span>

                <strong>
                    <%= totalCancelados %>
                </strong>

                <p>
                    Participações canceladas
                </p>

            </div>

        </section>


        <!-- =====================================================
             LISTAGEM
        ====================================================== -->

        <section class="admin-pagina-card participacoes-admin-listagem">

            <div class="participacoes-admin-listagem-topo">

                <div>

                    <span class="secao-etiqueta">
                        REGISTROS
                    </span>

                    <h2>
                        Participações cadastradas
                    </h2>

                    <p>
                        Consulte os voluntários vinculados
                        às campanhas e acompanhe a situação
                        de cada participação.
                    </p>

                </div>


                <span class="participacoes-admin-quantidade">

                    <%= totalParticipacoes %>

                    <%= totalParticipacoes === 1
                        ? 'participação'
                        : 'participações' %>

                </span>

            </div>


            <% if (listaParticipacoes.length === 0) { %>

                <div class="admin-vazio participacoes-admin-vazio">

                    <span class="secao-etiqueta">
                        NENHUM REGISTRO
                    </span>

                    <h3>
                        Nenhuma participação cadastrada
                    </h3>

                    <p>
                        Vincule um voluntário a uma campanha
                        para começar a organizar as participações
                        no Instituto.
                    </p>

                    <a
                        href="/admin/participacoes/nova"
                        class="btn-principal"
                    >
                        Cadastrar participação
                    </a>

                </div>

            <% } else { %>

                <div class="tabela-container participacoes-admin-tabela">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Voluntário
                                </th>

                                <th>
                                    Campanha
                                </th>

                                <th>
                                    Data da inscrição
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Ações
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% listaParticipacoes.forEach(participacao => { %>

                                <tr>

                                    <!-- ID -->

                                    <td>

                                        <span class="participacao-admin-id">
                                            #<%= participacao.id %>
                                        </span>

                                    </td>


                                    <!-- VOLUNTÁRIO -->

                                    <td>

                                        <div class="participacao-admin-voluntario">

                                            <div class="participacao-admin-avatar">

                                                <%= participacao.voluntario
                                                    .charAt(0)
                                                    .toUpperCase() %>

                                            </div>


                                            <div>

                                                <strong>
                                                    <%= participacao.voluntario %>
                                                </strong>

                                                <span>
                                                    Voluntário
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- CAMPANHA -->

                                    <td>

                                        <span class="participacao-admin-campanha">
                                            <%= participacao.campanha %>
                                        </span>

                                    </td>


                                    <!-- DATA -->

                                    <td>

                                        <span class="participacao-admin-data">

                                            <%= new Date(
                                                participacao.data_inscricao
                                            ).toLocaleDateString('pt-BR') %>

                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span
                                            class="status-admin status-<%= participacao.status.toLowerCase() %>"
                                        >

                                            <%= participacao.status === 'Concluido'
                                                ? 'Concluído'
                                                : participacao.status %>

                                        </span>

                                    </td>


                                    <!-- AÇÕES -->

                                    <td>

                                        <div class="acoes-tabela participacoes-admin-acoes">

                                            <a
                                                href="/admin/participacoes/<%= participacao.id %>/editar"
                                                class="btn-editar"
                                            >
                                                Editar
                                            </a>


                                            <form
                                                action="/admin/participacoes/<%= participacao.id %>/excluir"
                                                method="POST"
                                                onsubmit="return confirm('Deseja realmente excluir esta participação?')"
                                            >

                                                <button
                                                    type="submit"
                                                    class="btn-excluir"
                                                >
                                                    Excluir
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>