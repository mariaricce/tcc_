<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>

                <p class="admin-subtitulo">
                    Participações
                </p>

                <h1>Editar Participação</h1>

                <p>
                    Atualize o voluntário, a campanha ou o status.
                </p>

            </div>

            <a
                href="/admin/participacoes"
                class="btn-secundario"
            >
                ← Voltar
            </a>

        </div>


        <section class="admin-form-card">

            <% if (typeof erro !== 'undefined' && erro) { %>

                <div class="mensagem erro">
                    <%= erro %>
                </div>

            <% } %>


            <form
                action="/admin/participacoes/<%= participacao.id %>/editar"
                method="POST"
                class="formulario admin-formulario"
            >

                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="voluntario_id">
                            Voluntário *
                        </label>

                        <select
                            id="voluntario_id"
                            name="voluntario_id"
                            required
                        >

                            <% voluntarios.forEach(voluntario => { %>

                                <option
                                    value="<%= voluntario.id %>"
                                    <%= Number(participacao.voluntario_id) === Number(voluntario.id)
                                        ? 'selected'
                                        : '' %>
                                >
                                    <%= voluntario.nome %>
                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <div class="campo">

                        <label for="campanha_id">
                            Campanha *
                        </label>

                        <select
                            id="campanha_id"
                            name="campanha_id"
                            required
                        >

                            <% campanhas.forEach(campanha => { %>

                                <option
                                    value="<%= campanha.id %>"
                                    <%= Number(participacao.campanha_id) === Number(campanha.id)
                                        ? 'selected'
                                        : '' %>
                                >
                                    <%= campanha.titulo %>
                                </option>

                            <% }) %>

                        </select>

                    </div>

                </div>


                <div class="campo">

                    <label for="status">
                        Status *
                    </label>

                    <select
                        id="status"
                        name="status"
                        required
                    >

                        <option
                            value="Inscrito"
                            <%= participacao.status === 'Inscrito'
                                ? 'selected'
                                : '' %>
                        >
                            Inscrito
                        </option>

                        <option
                            value="Participando"
                            <%= participacao.status === 'Participando'
                                ? 'selected'
                                : '' %>
                        >
                            Participando
                        </option>

                        <option
                            value="Concluido"
                            <%= participacao.status === 'Concluido'
                                ? 'selected'
                                : '' %>
                        >
                            Concluído
                        </option>

                        <option
                            value="Cancelado"
                            <%= participacao.status === 'Cancelado'
                                ? 'selected'
                                : '' %>
                        >
                            Cancelado
                        </option>

                    </select>

                </div>


                <div class="admin-form-acoes">

                    <a
                        href="/admin/participacoes"
                        class="btn-secundario"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn-principal"
                    >
                        Salvar alterações
                    </button>

                </div>

            </form>

        </section>

    </main>

</div>

</body>
</html>