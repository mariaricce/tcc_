<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main>

    <section class="hero">

        <div class="container">

            <span class="home-etiqueta">
                INSTITUTO SOLIDARIZE
            </span>

            <h1>
                Juntos podemos transformar vidas
            </h1>

            <p>
                O Instituto Solidarize conecta pessoas, voluntários
                e ações sociais para apoiar quem mais precisa e
                fortalecer nossa comunidade.
            </p>

            <div class="hero-botoes">

                <a
                    href="/campanhas"
                    class="btn-principal"
                >
                    Conhecer campanhas
                </a>

                <a
                    href="/como-ajudar"
                    class="btn-secundario"
                >
                    Quero ajudar
                </a>

            </div>

        </div>

    </section>


    <section class="sobre-home">

        <div class="container">

            <span class="secao-etiqueta">
                QUEM SOMOS
            </span>

            <h2>
                Solidariedade que gera transformação
            </h2>

            <p>
                O Instituto Solidarize nasceu com o propósito de
                aproximar pessoas dispostas a ajudar de iniciativas
                que fazem diferença na vida da comunidade.
            </p>

            <p>
                Por meio de campanhas, doações, voluntariado e
                atendimentos, buscamos promover solidariedade,
                inclusão e apoio social.
            </p>

            <a href="/sobre">
                Conheça nossa história
            </a>

        </div>

    </section>


    <section class="home-ajudar">

        <div class="container">

            <div class="home-secao-cabecalho">

                <span class="secao-etiqueta">
                    FAÇA PARTE
                </span>

                <h2>
                    Existem várias formas de ajudar
                </h2>

                <p>
                    Cada contribuição pode fazer a diferença.
                    Escolha como você deseja participar.
                </p>

            </div>


            <div class="home-cards">

                <a
                    href="/quero-ser-voluntario"
                    class="home-card"
                >

                    <h3>
                        Seja voluntário
                    </h3>

                    <p>
                        Doe seu tempo e suas habilidades participando
                        das ações promovidas pelo Instituto.
                    </p>

                    <span>
                        Quero participar
                    </span>

                </a>


                <a
                    href="/campanhas"
                    class="home-card"
                >

                    <h3>
                        Apoie uma campanha
                    </h3>

                    <p>
                        Conheça nossas campanhas e descubra onde sua
                        contribuição pode ajudar.
                    </p>

                    <span>
                        Ver campanhas
                    </span>

                </a>


                <a
                    href="/como-ajudar"
                    class="home-card"
                >

                    <h3>
                        Faça uma doação
                    </h3>

                    <p>
                        Alimentos, roupas, materiais e outras
                        contribuições podem transformar vidas.
                    </p>

                    <span>
                        Como ajudar
                    </span>

                </a>

            </div>

        </div>

    </section>


    <section class="home-campanhas">

        <div class="container">

            <div class="home-chamada">

                <div>

                    <span class="secao-etiqueta">
                        NOSSAS AÇÕES
                    </span>

                    <h2>
                        Conheça nossas campanhas
                    </h2>

                    <p>
                        Acompanhe as iniciativas realizadas pelo Instituto
                        Solidarize e descubra como fazer parte delas.
                    </p>

                </div>

                <a
                    href="/campanhas"
                    class="btn-principal"
                >
                    Ver campanhas
                </a>

            </div>

        </div>

    </section>


    <section class="home-cta">

        <div class="container">

            <div class="home-cta-box">

                <span class="secao-etiqueta">
                    PARTICIPE
                </span>

                <h2>
                    Sua ajuda pode transformar uma história
                </h2>

                <p>
                    Seja voluntário, participe das campanhas,
                    faça uma doação ou ajude divulgando nossas ações.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/como-ajudar"
                        class="btn-principal"
                    >
                        Quero ajudar
                    </a>

                    <a
                        href="/contato"
                        class="btn-secundario"
                    >
                        Falar conosco
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>