<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="home-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="home-hero">

        <div class="container home-hero-container">

            <div class="home-hero-conteudo">

                <span class="home-etiqueta">
                    JUNTOS POR UM AMANHÃ MELHOR
                </span>

                <h1>
                    Transformando vidas através da
                    <span>solidariedade</span>
                </h1>

                <p>
                    O Instituto Solidarize atua para apoiar pessoas
                    e famílias em situação de vulnerabilidade,
                    promovendo ações que geram oportunidades,
                    acolhimento e esperança.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/como-ajudar"
                        class="btn-principal"
                    >
                        Quero ajudar
                    </a>

                    <a
                        href="/sobre"
                        class="btn-secundario"
                    >
                        Conheça nosso trabalho
                    </a>

                </div>

            </div>


            <div class="home-hero-visual">

                <img
                    src="/images/home-solidarize.png"
                    alt="Ação social promovida pelo Instituto Solidarize"
                >

                <div class="home-hero-frase">
                    <strong>
                        Mais pessoas.
                    </strong>

                    <span>
                        Mais histórias.
                    </span>

                    <span>
                        Mais oportunidades.
                    </span>

                </div>

            </div>

        </div>


        <!-- DESTAQUES -->

        <div class="container home-destaques">

            <div class="home-destaque-card">

                <span>
                    APOIO
                </span>

                <div>

                    <h3>
                        Apoio às famílias
                    </h3>

                    <p>
                        Ações que levam acolhimento,
                        recursos e oportunidades para
                        quem mais precisa.
                    </p>

                </div>

            </div>


            <div class="home-destaque-card">

                <span>
                    AÇÕES
                </span>

                <div>

                    <h3>
                        Campanhas solidárias
                    </h3>

                    <p>
                        Mobilizações que unem pessoas
                        e geram resultados reais na
                        comunidade.
                    </p>

                </div>

            </div>


            <div class="home-destaque-card">

                <span>
                    FUTURO
                </span>

                <div>

                    <h3>
                        Mais oportunidades
                    </h3>

                    <p>
                        Iniciativas que promovem inclusão,
                        dignidade e um futuro melhor.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         QUEM SOMOS
    ====================================================== -->

    <section class="sobre-home">

        <div class="container sobre-home-novo">

            <div>

                <span class="secao-etiqueta">
                    QUEM SOMOS
                </span>

                <h2>
                    Solidariedade que gera transformação
                </h2>

            </div>


            <div>

                <p>
                    O Instituto Solidarize nasceu com o propósito de
                    aproximar pessoas dispostas a ajudar de iniciativas
                    que fazem diferença na vida da comunidade.
                </p>

                <p>
                    Por meio de campanhas, doações, voluntariado e
                    atendimentos, buscamos promover solidariedade,
                    inclusão e apoio social.
                </p>

                <a
                    href="/sobre"
                    class="sobre-home-link"
                >
                    Conheça nossa história
                </a>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FORMAS DE AJUDAR
    ====================================================== -->

    <section class="home-ajudar">

        <div class="container">

            <div class="home-secao-cabecalho">

                <span class="secao-etiqueta">
                    FAÇA PARTE
                </span>

                <h2>
                    Existem várias formas de ajudar
                </h2>

                <p>
                    Cada contribuição pode fazer a diferença.
                    Escolha como você deseja participar.
                </p>

            </div>


            <div class="home-cards">

                <a
                    href="/quero-ser-voluntario"
                    class="home-card"
                >

                    <span class="home-card-numero">
                        01
                    </span>

                    <h3>
                        Seja voluntário
                    </h3>

                    <p>
                        Doe seu tempo e suas habilidades
                        participando das ações promovidas
                        pelo Instituto.
                    </p>

                    <strong>
                        Quero participar
                    </strong>

                </a>


                <a
                    href="/campanhas"
                    class="home-card"
                >

                    <span class="home-card-numero">
                        02
                    </span>

                    <h3>
                        Apoie uma campanha
                    </h3>

                    <p>
                        Conheça nossas campanhas e descubra
                        onde sua contribuição pode ajudar.
                    </p>

                    <strong>
                        Ver campanhas
                    </strong>

                </a>


                <a
                    href="/como-ajudar"
                    class="home-card"
                >

                    <span class="home-card-numero">
                        03
                    </span>

                    <h3>
                        Faça uma doação
                    </h3>

                    <p>
                        Sua contribuição pode ajudar nossas
                        campanhas a alcançar ainda mais pessoas.
                    </p>

                    <strong>
                        Como ajudar
                    </strong>

                </a>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CAMPANHAS
    ====================================================== -->

    <section class="home-campanhas">

        <div class="container">

            <div class="home-chamada">

                <div>

                    <span class="secao-etiqueta">
                        NOSSAS AÇÕES
                    </span>

                    <h2>
                        Conheça nossas campanhas
                    </h2>

                    <p>
                        Acompanhe as iniciativas realizadas pelo
                        Instituto Solidarize e descubra como fazer
                        parte delas.
                    </p>

                </div>


                <a
                    href="/campanhas"
                    class="btn-principal"
                >
                    Ver campanhas
                </a>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CHAMADA FINAL
    ====================================================== -->

    <section class="home-cta">

        <div class="container">

            <div class="home-cta-box">

                <span class="secao-etiqueta">
                    PARTICIPE
                </span>

                <h2>
                    Sua ajuda pode transformar uma história
                </h2>

                <p>
                    Seja voluntário, participe das campanhas,
                    faça uma doação ou ajude divulgando nossas ações.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/como-ajudar"
                        class="btn-principal"
                    >
                        Quero ajudar
                    </a>

                    <a
                        href="/contato"
                        class="btn-secundario"
                    >
                        Falar conosco
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>