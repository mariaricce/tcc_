<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>

                <p class="admin-subtitulo">
                    Instituto Solidarize
                </p>

                <h1>Voluntários</h1>

                <p>
                    Consulte e gerencie os voluntários da instituição.
                </p>

            </div>

            <a
                href="/admin/voluntarios/novo"
                class="btn-principal"
            >
                + Novo voluntário
            </a>

        </div>


        <section class="admin-pagina-card">

            <% if (voluntarios.length === 0) { %>

                <div class="admin-vazio">

                    <span>🤝</span>

                    <p>
                        Nenhum voluntário cadastrado.
                    </p>

                </div>

            <% } else { %>

                <div class="tabela-container">

                    <table>

                        <thead>

                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Telefone</th>
                                <th>Interesse</th>
                                <th>Disponibilidade</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>

                        </thead>

                        <tbody>

                            <% voluntarios.forEach(voluntario => { %>

                                <tr>

                                    <td>
                                        <%= voluntario.id %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= voluntario.nome %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= voluntario.email %>
                                    </td>

                                    <td>
                                        <%= voluntario.telefone || '-' %>
                                    </td>

                                    <td>
                                        <%= voluntario.area_interesse || '-' %>
                                    </td>

                                    <td>
                                        <%= voluntario.disponibilidade || '-' %>
                                    </td>

                                    <td>

                                        <span class="status-admin">
                                            <%= voluntario.status %>
                                        </span>

                                    </td>

                                    <td class="acoes-tabela">

                                        <a
                                            href="/admin/voluntarios/<%= voluntario.id %>/editar"
                                            class="btn-editar"
                                        >
                                            Editar
                                        </a>

                                        <form
                                            action="/admin/voluntarios/<%= voluntario.id %>/excluir"
                                            method="POST"
                                            onsubmit="return confirm('Deseja realmente excluir este voluntário?')"
                                        >

                                            <button
                                                type="submit"
                                                class="btn-excluir"
                                            >
                                                Excluir
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>