<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo admin-conteudo-novo">

        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <header class="admin-form-topo-novo">

            <div>

                <span class="secao-etiqueta">
                    VOLUNTÁRIOS
                </span>

                <h1>
                    Editar voluntário
                </h1>

                <p>
                    Atualize as informações de
                    <strong><%= voluntario.nome %></strong>
                    no Instituto Solidarize.
                </p>

            </div>


            <a
                href="/admin/voluntarios"
                class="btn-secundario"
            >
                Voltar para voluntários
            </a>

        </header>


        <!-- =====================================================
             CONTEÚDO
        ====================================================== -->

        <section class="voluntario-form-area">

            <div class="voluntario-form-grid-novo">


                <!-- =================================================
                     FORMULÁRIO
                ================================================== -->

                <div class="voluntario-form-principal">

                    <div class="voluntario-form-cabecalho">

                        <span class="secao-etiqueta">
                            EDITAR CADASTRO
                        </span>

                        <h2>
                            Informações do voluntário
                        </h2>

                        <p>
                            Altere somente os dados necessários
                            e salve as modificações.
                        </p>

                    </div>


                    <% if (erro) { %>

                        <div class="mensagem erro">
                            <%= erro %>
                        </div>

                    <% } %>


                    <form
                        action="/admin/voluntarios/<%= voluntario.id %>/editar"
                        method="POST"
                        class="formulario admin-formulario voluntario-formulario-novo"
                    >

                        <!-- =========================================
                             DADOS PESSOAIS
                        ========================================== -->

                        <div class="voluntario-form-bloco">

                            <div class="voluntario-form-bloco-titulo">

                                <span>
                                    01
                                </span>

                                <div>

                                    <h3>
                                        Dados pessoais
                                    </h3>

                                    <p>
                                        Atualize as informações
                                        de identificação e contato.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-form-grid">

                                <div class="campo">

                                    <label for="nome">
                                        Nome *
                                    </label>

                                    <input
                                        type="text"
                                        id="nome"
                                        name="nome"
                                        value="<%= voluntario.nome %>"
                                        autocomplete="name"
                                        required
                                    >

                                </div>


                                <div class="campo">

                                    <label for="email">
                                        E-mail *
                                    </label>

                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        value="<%= voluntario.email %>"
                                        autocomplete="email"
                                        required
                                    >

                                </div>

                            </div>


                            <div class="campo">

                                <label for="telefone">
                                    Telefone
                                </label>

                                <input
                                    type="text"
                                    id="telefone"
                                    name="telefone"
                                    value="<%= voluntario.telefone || '' %>"
                                    placeholder="(00) 00000-0000"
                                    autocomplete="tel"
                                >

                                <small class="campo-ajuda">
                                    O telefone é opcional, mas facilita
                                    o contato com o voluntário.
                                </small>

                            </div>

                        </div>


                        <!-- =========================================
                             PARTICIPAÇÃO
                        ========================================== -->

                        <div class="voluntario-form-bloco">

                            <div class="voluntario-form-bloco-titulo">

                                <span>
                                    02
                                </span>

                                <div>

                                    <h3>
                                        Interesse e disponibilidade
                                    </h3>

                                    <p>
                                        Atualize a área de interesse
                                        e o período de disponibilidade.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-form-grid">

                                <div class="campo">

                                    <label for="area_interesse">
                                        Área de interesse
                                    </label>

                                    <select
                                        id="area_interesse"
                                        name="area_interesse"
                                    >

                                        <option
                                            value=""
                                            <%= !voluntario.area_interesse
                                                ? 'selected'
                                                : '' %>
                                        >
                                            Selecione
                                        </option>


                                        <% [
                                            'Campanhas',
                                            'Arrecadações',
                                            'Eventos',
                                            'Atendimento',
                                            'Divulgação',
                                            'Outros'
                                        ].forEach(area => { %>

                                            <option
                                                value="<%= area %>"
                                                <%= voluntario.area_interesse === area
                                                    ? 'selected'
                                                    : '' %>
                                            >
                                                <%= area %>
                                            </option>

                                        <% }) %>

                                    </select>

                                </div>


                                <div class="campo">

                                    <label for="disponibilidade">
                                        Disponibilidade
                                    </label>

                                    <select
                                        id="disponibilidade"
                                        name="disponibilidade"
                                    >

                                        <option
                                            value=""
                                            <%= !voluntario.disponibilidade
                                                ? 'selected'
                                                : '' %>
                                        >
                                            Selecione
                                        </option>


                                        <% [
                                            'Manhã',
                                            'Tarde',
                                            'Noite',
                                            'Finais de semana',
                                            'Flexível'
                                        ].forEach(opcao => { %>

                                            <option
                                                value="<%= opcao %>"
                                                <%= voluntario.disponibilidade === opcao
                                                    ? 'selected'
                                                    : '' %>
                                            >
                                                <%= opcao %>
                                            </option>

                                        <% }) %>

                                    </select>

                                </div>

                            </div>

                        </div>


                        <!-- =========================================
                             STATUS
                        ========================================== -->

                        <div class="voluntario-form-bloco">

                            <div class="voluntario-form-bloco-titulo">

                                <span>
                                    03
                                </span>

                                <div>

                                    <h3>
                                        Situação do cadastro
                                    </h3>

                                    <p>
                                        Defina se este voluntário
                                        permanecerá ativo no sistema.
                                    </p>

                                </div>

                            </div>


                            <div class="campo">

                                <label for="status">
                                    Status *
                                </label>

                                <select
                                    id="status"
                                    name="status"
                                    required
                                >

                                    <option
                                        value="Ativo"
                                        <%= voluntario.status === 'Ativo'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        Ativo
                                    </option>

                                    <option
                                        value="Inativo"
                                        <%= voluntario.status === 'Inativo'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        Inativo
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- =========================================
                             AÇÕES
                        ========================================== -->

                        <div class="admin-form-acoes voluntario-form-acoes-novas">

                            <a
                                href="/admin/voluntarios"
                                class="btn-secundario"
                            >
                                Cancelar
                            </a>

                            <button
                                type="submit"
                                class="btn-principal"
                            >
                                Salvar alterações
                            </button>

                        </div>

                    </form>

                </div>


                <!-- =================================================
                     PAINEL LATERAL
                ================================================== -->

                <aside class="voluntario-form-lateral">

                    <div class="voluntario-form-ajuda-card">

                        <span class="secao-etiqueta">
                            VOLUNTÁRIO
                        </span>

                        <h2>
                            Dados atuais
                        </h2>

                        <p>
                            Confira algumas informações do cadastro
                            antes de realizar alterações.
                        </p>


                        <div class="voluntario-form-ajuda-item">

                            <span>
                                01
                            </span>

                            <div>

                                <strong>
                                    Identificação
                                </strong>

                                <p>
                                    Voluntário #<%= voluntario.id %>
                                </p>

                            </div>

                        </div>


                        <div class="voluntario-form-ajuda-item">

                            <span>
                                02
                            </span>

                            <div>

                                <strong>
                                    E-mail
                                </strong>

                                <p>
                                    <%= voluntario.email %>
                                </p>

                            </div>

                        </div>


                        <div class="voluntario-form-ajuda-item">

                            <span>
                                03
                            </span>

                            <div>

                                <strong>
                                    Área de interesse
                                </strong>

                                <p>
                                    <%= voluntario.area_interesse
                                        || 'Não informada' %>
                                </p>

                            </div>

                        </div>


                        <div class="voluntario-form-ajuda-item">

                            <span>
                                04
                            </span>

                            <div>

                                <strong>
                                    Disponibilidade
                                </strong>

                                <p>
                                    <%= voluntario.disponibilidade
                                        || 'Não informada' %>
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="voluntario-form-status-card">

                        <span>
                            STATUS ATUAL
                        </span>

                        <strong>
                            <%= voluntario.status %>
                        </strong>

                        <p>
                            Voluntários inativos permanecem
                            cadastrados no sistema e podem
                            ser reativados posteriormente.
                        </p>

                    </div>

                </aside>

            </div>

        </section>

    </main>

</div>

</body>
</html>