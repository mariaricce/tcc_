<%- include('../partials/header') %>

<%- include('../partials/navbar') %>

<main class="usuario-painel usuario-painel-novo">

    <!-- =====================================================
         BOAS-VINDAS
    ====================================================== -->

    <section class="usuario-hero">

        <div class="container usuario-hero-grid">

            <div class="usuario-hero-conteudo">

                <span class="secao-etiqueta">
                    SUA ÁREA
                </span>

                <h1>
                    Olá,
                    <span><%= usuario.nome %></span>
                </h1>

                <p>
                    Bem-vindo à sua área no Instituto Solidarize.
                    Aqui você pode conhecer nossas campanhas,
                    participar das ações e descobrir novas
                    maneiras de contribuir.
                </p>

                <div class="usuario-hero-acoes">

                    <a
                        href="/campanhas"
                        class="btn-principal"
                    >
                        Ver campanhas
                    </a>

                    <a
                        href="/como-ajudar"
                        class="btn-secundario"
                    >
                        Como ajudar
                    </a>

                </div>

            </div>


            <div class="usuario-hero-card">

                <span class="usuario-hero-card-etiqueta">
                    MINHA CONTA
                </span>

                <div class="usuario-avatar-novo">

                    <%= usuario.nome.charAt(0).toUpperCase() %>

                </div>

                <h2>
                    <%= usuario.nome %>
                </h2>

                <p>
                    Conta de usuário do Instituto Solidarize.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <section class="usuario-conteudo usuario-conteudo-novo">

        <div class="container">

            <!-- =================================================
                 DADOS DA CONTA
            ================================================== -->

            <section class="usuario-conta-nova">

                <div class="usuario-conta-cabecalho">

                    <div>

                        <span class="secao-etiqueta">
                            MINHA CONTA
                        </span>

                        <h2>
                            Informações do cadastro
                        </h2>

                    </div>

                    <p>
                        Estes são os dados associados à sua conta.
                    </p>

                </div>


                <div class="usuario-dados-novos">

                    <div class="usuario-dado-novo">

                        <span>
                            NOME
                        </span>

                        <strong>
                            <%= usuario.nome %>
                        </strong>

                    </div>


                    <div class="usuario-dado-novo">

                        <span>
                            E-MAIL
                        </span>

                        <strong>
                            <%= usuario.email %>
                        </strong>

                    </div>


                    <div class="usuario-dado-novo">

                        <span>
                            TIPO DE CONTA
                        </span>

                        <strong>
                            Usuário
                        </strong>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 AÇÕES
            ================================================== -->

            <section class="usuario-secao usuario-secao-nova">

                <div class="usuario-secao-cabecalho">

                    <div>

                        <span class="secao-etiqueta">
                            PARTICIPE
                        </span>

                        <h2>
                            O que você pode fazer?
                        </h2>

                    </div>

                    <p>
                        Escolha uma das opções e faça parte
                        das ações do Instituto Solidarize.
                    </p>

                </div>


                <div class="usuario-acoes-novas">


                    <a
                        href="/campanhas"
                        class="usuario-acao-nova"
                    >

                        <span class="usuario-acao-numero">
                            01
                        </span>

                        <div>

                            <span class="secao-etiqueta">
                                CAMPANHAS
                            </span>

                            <h3>
                                Conheça nossas campanhas
                            </h3>

                            <p>
                                Veja as campanhas ativas,
                                acompanhe as metas e escolha
                                uma ação para apoiar.
                            </p>

                            <strong>
                                Ver campanhas
                            </strong>

                        </div>

                    </a>


                    <a
                        href="/quero-ser-voluntario"
                        class="usuario-acao-nova"
                    >

                        <span class="usuario-acao-numero">
                            02
                        </span>

                        <div>

                            <span class="secao-etiqueta">
                                VOLUNTARIADO
                            </span>

                            <h3>
                                Seja voluntário
                            </h3>

                            <p>
                                Cadastre-se para participar
                                das ações e contribuir com seu
                                tempo e suas habilidades.
                            </p>

                            <strong>
                                Quero participar
                            </strong>

                        </div>

                    </a>


                    <a
                        href="/como-ajudar"
                        class="usuario-acao-nova"
                    >

                        <span class="usuario-acao-numero">
                            03
                        </span>

                        <div>

                            <span class="secao-etiqueta">
                                PARTICIPAÇÃO
                            </span>

                            <h3>
                                Outras formas de ajudar
                            </h3>

                            <p>
                                Descubra outras maneiras
                                de colaborar com o Instituto
                                e fortalecer nossas ações.
                            </p>

                            <strong>
                                Saiba mais
                            </strong>

                        </div>

                    </a>


                    <a
                        href="/contato"
                        class="usuario-acao-nova"
                    >

                        <span class="usuario-acao-numero">
                            04
                        </span>

                        <div>

                            <span class="secao-etiqueta">
                                CONTATO
                            </span>

                            <h3>
                                Fale com nossa equipe
                            </h3>

                            <p>
                                Entre em contato caso tenha
                                dúvidas sobre campanhas,
                                doações ou voluntariado.
                            </p>

                            <strong>
                                Falar conosco
                            </strong>

                        </div>

                    </a>

                </div>

            </section>


            <!-- =================================================
                 CHAMADA
            ================================================== -->

            <section class="usuario-chamada">

                <div>

                    <span class="secao-etiqueta">
                        SOLIDARIZE
                    </span>

                    <h2>
                        Sua participação pode
                        <span>transformar histórias</span>
                    </h2>

                    <p>
                        Cada contribuição ajuda a fortalecer
                        as ações do Instituto e ampliar
                        nosso impacto na comunidade.
                    </p>

                </div>

                <a
                    href="/campanhas"
                    class="btn-principal"
                >
                    Apoiar uma campanha
                </a>

            </section>


            <!-- =================================================
                 SAIR
            ================================================== -->

            <section class="usuario-sair-novo">

                <div>

                    <h3>
                        Deseja sair da sua conta?
                    </h3>

                    <p>
                        Você poderá entrar novamente usando
                        seu e-mail e sua senha.
                    </p>

                </div>


                <form
                    action="/logout"
                    method="POST"
                >

                    <button
                        type="submit"
                        class="btn-sair-conta"
                    >
                        Sair da conta
                    </button>

                </form>

            </section>

        </div>

    </section>

</main>

<%- include('../partials/footer') %>