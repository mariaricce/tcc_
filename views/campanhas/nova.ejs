<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>

                <p class="admin-subtitulo">
                    Campanhas
                </p>

                <h1>
                    Nova Campanha
                </h1>

                <p>
                    Cadastre uma nova campanha social.
                </p>

            </div>

            <a
                href="/admin/campanhas"
                class="btn-secundario"
            >
                Voltar
            </a>

        </div>


        <section class="admin-form-card">

            <% if (erro) { %>

                <div class="mensagem erro">
                    <%= erro %>
                </div>

            <% } %>


            <form
                action="/admin/campanhas/nova"
                method="POST"
                enctype="multipart/form-data"
                class="formulario admin-formulario"
            >

                <div class="campo">

                    <label for="titulo">
                        Título *
                    </label>

                    <input
                        type="text"
                        id="titulo"
                        name="titulo"
                        placeholder="Nome da campanha"
                        maxlength="150"
                        required
                    >

                </div>


                <div class="campo">

                    <label for="descricao">
                        Descrição *
                    </label>

                    <textarea
                        id="descricao"
                        name="descricao"
                        rows="5"
                        placeholder="Descreva o objetivo da campanha"
                        required
                    ></textarea>

                </div>


                <div class="campo">

                    <label for="imagem">
                        Imagem da campanha
                    </label>

                    <input
                        type="file"
                        id="imagem"
                        name="imagem"
                        accept="image/jpeg,image/png,image/webp"
                    >

                    <small class="campo-ajuda">
                        Formatos permitidos: JPG, PNG ou WEBP.
                        Tamanho máximo: 5 MB.
                    </small>

                </div>


                <div
                    id="preview-container"
                    class="campanha-preview"
                    hidden
                >

                    <p class="campanha-preview-titulo">
                        Pré-visualização
                    </p>

                    <img
                        id="preview-imagem"
                        src=""
                        alt="Pré-visualização da imagem da campanha"
                    >

                </div>


                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="data_inicio">
                            Data de início *
                        </label>

                        <input
                            type="date"
                            id="data_inicio"
                            name="data_inicio"
                            required
                        >

                    </div>


                    <div class="campo">

                        <label for="data_fim">
                            Data de término
                        </label>

                        <input
                            type="date"
                            id="data_fim"
                            name="data_fim"
                        >

                    </div>

                </div>


                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="meta">
                            Meta em R$
                        </label>

                        <input
                            type="number"
                            id="meta"
                            name="meta"
                            step="0.01"
                            min="0"
                            placeholder="0,00"
                        >

                    </div>


                    <div class="campo">

                        <label for="status">
                            Status *
                        </label>

                        <select
                            id="status"
                            name="status"
                            required
                        >

                            <option value="Ativa">
                                Ativa
                            </option>

                            <option value="Pausada">
                                Pausada
                            </option>

                            <option value="Encerrada">
                                Encerrada
                            </option>

                        </select>

                    </div>

                </div>


                <div class="admin-form-acoes">

                    <a
                        href="/admin/campanhas"
                        class="btn-secundario"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn-principal"
                    >
                        Cadastrar campanha
                    </button>

                </div>

            </form>

        </section>

    </main>

</div>


<script>

    document.addEventListener(
        'DOMContentLoaded',
        () => {

            const inputImagem =
                document.getElementById('imagem');

            const previewContainer =
                document.getElementById(
                    'preview-container'
                );

            const previewImagem =
                document.getElementById(
                    'preview-imagem'
                );


            if (
                !inputImagem ||
                !previewContainer ||
                !previewImagem
            ) {
                return;
            }


            inputImagem.addEventListener(
                'change',
                () => {

                    const arquivo =
                        inputImagem.files[0];


                    if (!arquivo) {

                        previewContainer.hidden = true;

                        previewImagem.src = '';

                        return;

                    }


                    const tiposPermitidos = [
                        'image/jpeg',
                        'image/png',
                        'image/webp'
                    ];


                    if (
                        !tiposPermitidos.includes(
                            arquivo.type
                        )
                    ) {

                        inputImagem.value = '';

                        previewContainer.hidden = true;

                        alert(
                            'Selecione uma imagem JPG, PNG ou WEBP.'
                        );

                        return;

                    }


                    const limite =
                        5 * 1024 * 1024;


                    if (arquivo.size > limite) {

                        inputImagem.value = '';

                        previewContainer.hidden = true;

                        alert(
                            'A imagem deve ter no máximo 5 MB.'
                        );

                        return;

                    }


                    const leitor =
                        new FileReader();


                    leitor.addEventListener(
                        'load',
                        () => {

                            previewImagem.src =
                                leitor.result;

                            previewContainer.hidden =
                                false;

                        }
                    );


                    leitor.readAsDataURL(
                        arquivo
                    );

                }
            );

        }
    );

</script>

</body>
</html>