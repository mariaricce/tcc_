<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo admin-conteudo-novo">

        <%
            const listaCampanhas = campanhas || [];

            const totalCampanhas =
                listaCampanhas.length;

            const campanhasAtivas =
                listaCampanhas.filter(
                    campanha => campanha.status === 'Ativa'
                ).length;

            const campanhasPausadas =
                listaCampanhas.filter(
                    campanha => campanha.status === 'Pausada'
                ).length;

            const campanhasEncerradas =
                listaCampanhas.filter(
                    campanha => campanha.status === 'Encerrada'
                ).length;

            const totalArrecadado =
                listaCampanhas.reduce(
                    (total, campanha) =>
                        total +
                        Number(campanha.valor_arrecadado || 0),
                    0
                );
        %>


        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <header class="admin-listagem-topo">

            <div>

                <span class="secao-etiqueta">
                    GERENCIAMENTO
                </span>

                <h1>
                    Campanhas
                </h1>

                <p>
                    Cadastre, acompanhe e gerencie as campanhas
                    realizadas pelo Instituto Solidarize.
                </p>

            </div>


            <a
                href="/admin/campanhas/nova"
                class="btn-principal"
            >
                Nova campanha
            </a>

        </header>


        <!-- =====================================================
             MENSAGENS
        ====================================================== -->

        <% if (erroExclusao) { %>

            <div class="mensagem erro admin-mensagem-listagem">

                Esta campanha possui registros vinculados
                e não pode ser excluída.

                Altere o status para Encerrada caso
                ela não esteja mais ativa.

            </div>

        <% } %>


        <% if (sucessoExclusao) { %>

            <div class="mensagem sucesso admin-mensagem-listagem">
                Campanha excluída com sucesso.
            </div>

        <% } %>


        <!-- =====================================================
             RESUMO
        ====================================================== -->

        <section class="campanhas-admin-resumo">

            <div class="campanhas-admin-resumo-card">

                <span>
                    TOTAL
                </span>

                <strong>
                    <%= totalCampanhas %>
                </strong>

                <p>
                    Campanhas cadastradas
                </p>

            </div>


            <div class="campanhas-admin-resumo-card">

                <span>
                    ATIVAS
                </span>

                <strong>
                    <%= campanhasAtivas %>
                </strong>

                <p>
                    Campanhas em andamento
                </p>

            </div>


            <div class="campanhas-admin-resumo-card">

                <span>
                    PAUSADAS
                </span>

                <strong>
                    <%= campanhasPausadas %>
                </strong>

                <p>
                    Campanhas temporariamente pausadas
                </p>

            </div>


            <div class="campanhas-admin-resumo-card">

                <span>
                    ENCERRADAS
                </span>

                <strong>
                    <%= campanhasEncerradas %>
                </strong>

                <p>
                    Campanhas finalizadas
                </p>

            </div>

        </section>


        <!-- =====================================================
             VALOR ARRECADADO
        ====================================================== -->

        <section class="campanhas-admin-arrecadacao-total">

            <div>

                <span class="secao-etiqueta">
                    ARRECADAÇÃO
                </span>

                <h2>
                    Total recebido pelas campanhas
                </h2>

                <p>
                    Soma das doações confirmadas
                    vinculadas às campanhas cadastradas.
                </p>

            </div>


            <strong>
                R$
                <%= totalArrecadado
                    .toFixed(2)
                    .replace('.', ',') %>
            </strong>

        </section>


        <!-- =====================================================
             LISTAGEM
        ====================================================== -->

        <section class="admin-pagina-card campanhas-admin-listagem">

            <div class="campanhas-admin-listagem-topo">

                <div>

                    <span class="secao-etiqueta">
                        REGISTROS
                    </span>

                    <h2>
                        Campanhas cadastradas
                    </h2>

                    <p>
                        Consulte informações, edite campanhas
                        existentes ou altere seus dados.
                    </p>

                </div>


                <span class="campanhas-admin-quantidade">

                    <%= totalCampanhas %>

                    <%= totalCampanhas === 1
                        ? 'campanha'
                        : 'campanhas' %>

                </span>

            </div>


            <% if (listaCampanhas.length === 0) { %>

                <div class="admin-vazio campanhas-admin-vazio">

                    <span class="secao-etiqueta">
                        NENHUM REGISTRO
                    </span>

                    <h3>
                        Nenhuma campanha cadastrada
                    </h3>

                    <p>
                        Cadastre a primeira campanha
                        para começar a organizar as ações
                        do Instituto Solidarize.
                    </p>

                    <a
                        href="/admin/campanhas/nova"
                        class="btn-principal"
                    >
                        Cadastrar campanha
                    </a>

                </div>

            <% } else { %>

                <div class="tabela-container campanhas-admin-tabela">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Campanha
                                </th>

                                <th>
                                    Período
                                </th>

                                <th>
                                    Meta
                                </th>

                                <th>
                                    Arrecadado
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Ações
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% listaCampanhas.forEach(campanha => { %>

                                <tr>


                                    <!-- ID -->

                                    <td>

                                        <span class="campanha-admin-id">
                                            #<%= campanha.id %>
                                        </span>

                                    </td>


                                    <!-- CAMPANHA -->

                                    <td>

                                        <div class="campanha-admin-identidade">

                                            <% if (campanha.imagem) { %>

                                                <div class="campanha-admin-imagem">

                                                    <img
                                                        src="/images/campanhas/<%= campanha.imagem %>"
                                                        alt="Imagem da campanha <%= campanha.titulo %>"
                                                        loading="lazy"
                                                    >

                                                </div>

                                            <% } else { %>

                                                <div class="campanha-admin-sem-imagem">
                                                    <span>
                                                        Sem imagem
                                                    </span>
                                                </div>

                                            <% } %>


                                            <div class="campanha-admin-titulo">

                                                <strong>
                                                    <%= campanha.titulo %>
                                                </strong>

                                                <span>
                                                    Campanha institucional
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- PERÍODO -->

                                    <td>

                                        <div class="campanha-admin-periodo">

                                            <span>
                                                Início
                                            </span>

                                            <strong>
                                                <%= new Date(
                                                    campanha.data_inicio
                                                ).toLocaleDateString('pt-BR') %>
                                            </strong>


                                            <span>
                                                Término
                                            </span>

                                            <strong>

                                                <% if (campanha.data_fim) { %>

                                                    <%= new Date(
                                                        campanha.data_fim
                                                    ).toLocaleDateString('pt-BR') %>

                                                <% } else { %>

                                                    Não definido

                                                <% } %>

                                            </strong>

                                        </div>

                                    </td>


                                    <!-- META -->

                                    <td>

                                        <% if (campanha.meta) { %>

                                            <strong class="campanha-admin-meta">

                                                R$
                                                <%= Number(
                                                    campanha.meta
                                                )
                                                    .toFixed(2)
                                                    .replace('.', ',') %>

                                            </strong>

                                        <% } else { %>

                                            <span class="campanha-admin-sem-valor">
                                                Não definida
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ARRECADADO -->

                                    <td>

                                        <strong class="campanha-admin-arrecadado">

                                            R$
                                            <%= Number(
                                                campanha.valor_arrecadado || 0
                                            )
                                                .toFixed(2)
                                                .replace('.', ',') %>

                                        </strong>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span
                                            class="status-admin status-<%= campanha.status.toLowerCase() %>"
                                        >
                                            <%= campanha.status %>
                                        </span>

                                    </td>


                                    <!-- AÇÕES -->

                                    <td>

                                        <div class="acoes-tabela campanhas-admin-acoes">

                                            <a
                                                href="/admin/campanhas/<%= campanha.id %>/editar"
                                                class="btn-editar"
                                            >
                                                Editar
                                            </a>


                                            <form
                                                action="/admin/campanhas/<%= campanha.id %>/excluir"
                                                method="POST"
                                                onsubmit="return confirm('Deseja realmente excluir esta campanha?')"
                                            >

                                                <button
                                                    type="submit"
                                                    class="btn-excluir"
                                                >
                                                    Excluir
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>