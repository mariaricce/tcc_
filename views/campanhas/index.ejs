<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>

                <p class="admin-subtitulo">
                    Instituto Solidarize
                </p>

                <h1>
                    Campanhas
                </h1>

                <p>
                    Gerencie todas as campanhas da instituição.
                </p>

            </div>


            <a
                href="/admin/campanhas/nova"
                class="btn-principal"
            >
                Nova campanha
            </a>

        </div>


        <!-- MENSAGENS -->

        <% if (erroExclusao) { %>

            <div class="mensagem erro">

                Esta campanha possui registros vinculados
                e não pode ser excluída.

                Altere o status para Encerrada caso
                ela não esteja mais ativa.

            </div>

        <% } %>


        <% if (sucessoExclusao) { %>

            <div class="mensagem sucesso">

                Campanha excluída com sucesso.

            </div>

        <% } %>


        <section class="admin-pagina-card">

            <% if (!campanhas || campanhas.length === 0) { %>

                <div class="admin-vazio">

                    <p>
                        Nenhuma campanha cadastrada.
                    </p>

                    <a
                        href="/admin/campanhas/nova"
                        class="btn-principal"
                    >
                        Cadastrar campanha
                    </a>

                </div>

            <% } else { %>

                <div class="tabela-container">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Imagem
                                </th>

                                <th>
                                    Título
                                </th>

                                <th>
                                    Início
                                </th>

                                <th>
                                    Fim
                                </th>

                                <th>
                                    Meta
                                </th>

                                <th>
                                    Arrecadado
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Ações
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% campanhas.forEach(campanha => { %>

                                <tr>

                                    <!-- ID -->

                                    <td>
                                        <%= campanha.id %>
                                    </td>


                                    <!-- IMAGEM -->

                                    <td>

                                        <% if (campanha.imagem) { %>

                                            <div class="campanha-admin-imagem">

                                                <img
                                                    src="/images/campanhas/<%= campanha.imagem %>"
                                                    alt="Imagem da campanha <%= campanha.titulo %>"
                                                    loading="lazy"
                                                >

                                            </div>

                                        <% } else { %>

                                            <span class="campanha-sem-imagem">
                                                Sem imagem
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- TÍTULO -->

                                    <td>

                                        <strong>
                                            <%= campanha.titulo %>
                                        </strong>

                                    </td>


                                    <!-- DATA INÍCIO -->

                                    <td>

                                        <%= new Date(
                                            campanha.data_inicio
                                        ).toLocaleDateString('pt-BR') %>

                                    </td>


                                    <!-- DATA FIM -->

                                    <td>

                                        <% if (campanha.data_fim) { %>

                                            <%= new Date(
                                                campanha.data_fim
                                            ).toLocaleDateString('pt-BR') %>

                                        <% } else { %>

                                            Não definida

                                        <% } %>

                                    </td>


                                    <!-- META -->

                                    <td>

                                        <% if (campanha.meta) { %>

                                            R$
                                            <%= Number(
                                                campanha.meta
                                            )
                                                .toFixed(2)
                                                .replace('.', ',') %>

                                        <% } else { %>

                                            Não definida

                                        <% } %>

                                    </td>


                                    <!-- ARRECADADO -->

                                    <td>

                                        <strong class="campanha-admin-arrecadado">

                                            R$

                                            <%= Number(
                                                campanha.valor_arrecadado || 0
                                            )
                                                .toFixed(2)
                                                .replace('.', ',') %>

                                        </strong>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span
                                            class="status-admin status-<%= campanha.status.toLowerCase() %>"
                                        >
                                            <%= campanha.status %>
                                        </span>

                                    </td>


                                    <!-- AÇÕES -->

                                    <td class="acoes-tabela">

                                        <a
                                            href="/admin/campanhas/<%= campanha.id %>/editar"
                                            class="btn-editar"
                                        >
                                            Editar
                                        </a>


                                        <form
                                            action="/admin/campanhas/<%= campanha.id %>/excluir"
                                            method="POST"
                                            onsubmit="return confirm('Deseja realmente excluir esta campanha?')"
                                        >

                                            <button
                                                type="submit"
                                                class="btn-excluir"
                                            >
                                                Excluir
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>