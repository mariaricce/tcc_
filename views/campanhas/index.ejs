<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>
                <p class="admin-subtitulo">
                    Instituto Solidarize
                </p>

                <h1>Campanhas</h1>

                <p>
                    Gerencie todas as campanhas da instituição.
                </p>
            </div>

            <a
                href="/admin/campanhas/nova"
                class="btn-principal"
            >
                + Nova campanha
            </a>

        </div>


        <section class="admin-pagina-card">

            <% if (campanhas.length === 0) { %>

                <div class="admin-vazio">
                    <span>📢</span>

                    <p>
                        Nenhuma campanha cadastrada.
                    </p>
                </div>

            <% } else { %>

                <div class="tabela-container">

                    <table>

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Título</th>
                                <th>Início</th>
                                <th>Fim</th>
                                <th>Meta</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>


                        <tbody>

                            <% campanhas.forEach(campanha => { %>

                                <tr>

                                    <td>
                                        <%= campanha.id %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= campanha.titulo %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= new Date(
                                            campanha.data_inicio
                                        ).toLocaleDateString('pt-BR') %>
                                    </td>

                                    <td>

                                        <% if (campanha.data_fim) { %>

                                            <%= new Date(
                                                campanha.data_fim
                                            ).toLocaleDateString('pt-BR') %>

                                        <% } else { %>

                                            -

                                        <% } %>

                                    </td>


                                    <td>

                                        <% if (campanha.meta) { %>

                                            R$
                                            <%= Number(campanha.meta)
                                                .toFixed(2)
                                                .replace('.', ',') %>

                                        <% } else { %>

                                            -

                                        <% } %>

                                    </td>


                                    <td>

                                        <span class="status-admin">
                                            <%= campanha.status %>
                                        </span>

                                    </td>


                                    <td class="acoes-tabela">

                                        <a
                                            href="/admin/campanhas/<%= campanha.id %>/editar"
                                            class="btn-editar"
                                        >
                                            Editar
                                        </a>


                                        <form
                                            action="/admin/campanhas/<%= campanha.id %>/excluir"
                                            method="POST"
                                            onsubmit="return confirm('Deseja realmente excluir esta campanha?')"
                                        >

                                            <button
                                                type="submit"
                                                class="btn-excluir"
                                            >
                                                Excluir
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>