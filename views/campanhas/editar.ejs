<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>

                <p class="admin-subtitulo">
                    Campanhas
                </p>

                <h1>
                    Editar Campanha
                </h1>

                <p>
                    Altere as informações da campanha.
                </p>

            </div>

            <a
                href="/admin/campanhas"
                class="btn-secundario"
            >
                Voltar
            </a>

        </div>


        <section class="admin-form-card">

            <% if (erro) { %>

                <div class="mensagem erro">
                    <%= erro %>
                </div>

            <% } %>


            <form
                action="/admin/campanhas/<%= campanha.id %>/editar"
                method="POST"
                enctype="multipart/form-data"
                class="formulario admin-formulario"
            >

                <div class="campo">

                    <label for="titulo">
                        Título *
                    </label>

                    <input
                        type="text"
                        id="titulo"
                        name="titulo"
                        value="<%= campanha.titulo %>"
                        maxlength="150"
                        required
                    >

                </div>


                <div class="campo">

                    <label for="descricao">
                        Descrição *
                    </label>

                    <textarea
                        id="descricao"
                        name="descricao"
                        rows="5"
                        required
                    ><%= campanha.descricao %></textarea>

                </div>


                <div class="campo">

                    <label>
                        Imagem da campanha
                    </label>


                    <% if (campanha.imagem) { %>

                        <div
                            id="preview-container"
                            class="campanha-preview"
                        >

                            <p class="campanha-preview-titulo">
                                Imagem atual
                            </p>

                            <img
                                id="preview-imagem"
                                src="/images/campanhas/<%= campanha.imagem %>"
                                alt="Imagem da campanha <%= campanha.titulo %>"
                            >

                        </div>

                    <% } else { %>

                        <div
                            id="preview-container"
                            class="campanha-preview"
                            hidden
                        >

                            <p class="campanha-preview-titulo">
                                Pré-visualização
                            </p>

                            <img
                                id="preview-imagem"
                                src=""
                                alt="Pré-visualização da imagem da campanha"
                            >

                        </div>

                        <p
                            id="sem-imagem"
                            class="campo-ajuda"
                        >
                            Esta campanha ainda não possui imagem.
                        </p>

                    <% } %>

                </div>


                <div class="campo">

                    <label for="imagem">
                        Alterar imagem
                    </label>

                    <input
                        type="file"
                        id="imagem"
                        name="imagem"
                        accept="image/jpeg,image/png,image/webp"
                    >

                    <small class="campo-ajuda">
                        Se nenhuma nova imagem for escolhida,
                        a imagem atual será mantida.
                        Formatos permitidos: JPG, PNG ou WEBP.
                        Tamanho máximo: 5 MB.
                    </small>

                </div>


                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="data_inicio">
                            Data de início *
                        </label>

                        <input
                            type="date"
                            id="data_inicio"
                            name="data_inicio"
                            value="<%= campanha.data_inicio %>"
                            required
                        >

                    </div>


                    <div class="campo">

                        <label for="data_fim">
                            Data de término
                        </label>

                        <input
                            type="date"
                            id="data_fim"
                            name="data_fim"
                            value="<%= campanha.data_fim || '' %>"
                        >

                    </div>

                </div>


                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="meta">
                            Meta em R$
                        </label>

                        <input
                            type="number"
                            id="meta"
                            name="meta"
                            step="0.01"
                            min="0"
                            value="<%= campanha.meta || '' %>"
                        >

                    </div>


                    <div class="campo">

                        <label for="status">
                            Status *
                        </label>

                        <select
                            id="status"
                            name="status"
                            required
                        >

                            <option
                                value="Ativa"
                                <%= campanha.status === 'Ativa'
                                    ? 'selected'
                                    : '' %>
                            >
                                Ativa
                            </option>

                            <option
                                value="Pausada"
                                <%= campanha.status === 'Pausada'
                                    ? 'selected'
                                    : '' %>
                            >
                                Pausada
                            </option>

                            <option
                                value="Encerrada"
                                <%= campanha.status === 'Encerrada'
                                    ? 'selected'
                                    : '' %>
                            >
                                Encerrada
                            </option>

                        </select>

                    </div>

                </div>


                <div class="admin-form-acoes">

                    <a
                        href="/admin/campanhas"
                        class="btn-secundario"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn-principal"
                    >
                        Salvar alterações
                    </button>

                </div>

            </form>

        </section>

    </main>

</div>


<script>

    document.addEventListener(
        'DOMContentLoaded',
        () => {

            const inputImagem =
                document.getElementById('imagem');

            const previewContainer =
                document.getElementById(
                    'preview-container'
                );

            const previewImagem =
                document.getElementById(
                    'preview-imagem'
                );

            const semImagem =
                document.getElementById(
                    'sem-imagem'
                );


            if (
                !inputImagem ||
                !previewContainer ||
                !previewImagem
            ) {
                return;
            }


            inputImagem.addEventListener(
                'change',
                () => {

                    const arquivo =
                        inputImagem.files[0];


                    if (!arquivo) {
                        return;
                    }


                    const tiposPermitidos = [
                        'image/jpeg',
                        'image/png',
                        'image/webp'
                    ];


                    if (
                        !tiposPermitidos.includes(
                            arquivo.type
                        )
                    ) {

                        inputImagem.value = '';

                        alert(
                            'Selecione uma imagem JPG, PNG ou WEBP.'
                        );

                        return;

                    }


                    const limite =
                        5 * 1024 * 1024;


                    if (arquivo.size > limite) {

                        inputImagem.value = '';

                        alert(
                            'A imagem deve ter no máximo 5 MB.'
                        );

                        return;

                    }


                    const leitor =
                        new FileReader();


                    leitor.addEventListener(
                        'load',
                        () => {

                            previewImagem.src =
                                leitor.result;

                            previewContainer.hidden =
                                false;


                            const tituloPreview =
                                previewContainer
                                    .querySelector(
                                        '.campanha-preview-titulo'
                                    );


                            if (tituloPreview) {

                                tituloPreview.textContent =
                                    'Nova imagem';

                            }


                            if (semImagem) {

                                semImagem.hidden = true;

                            }

                        }
                    );


                    leitor.readAsDataURL(
                        arquivo
                    );

                }
            );

        }
    );

</script>

</body>
</html>