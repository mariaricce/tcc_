<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo admin-conteudo-novo">

        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <header class="admin-form-topo-novo">

            <div>

                <span class="secao-etiqueta">
                    CAMPANHAS
                </span>

                <h1>
                    Editar campanha
                </h1>

                <p>
                    Atualize as informações da campanha
                    <strong><%= campanha.titulo %></strong>.
                </p>

            </div>


            <a
                href="/admin/campanhas"
                class="btn-secundario"
            >
                Voltar para campanhas
            </a>

        </header>


        <!-- =====================================================
             CONTEÚDO
        ====================================================== -->

        <section class="campanha-form-area">

            <div class="campanha-form-grid-novo">


                <!-- =================================================
                     FORMULÁRIO
                ================================================== -->

                <div class="campanha-form-principal">

                    <div class="campanha-form-cabecalho">

                        <span class="secao-etiqueta">
                            EDITAR CAMPANHA
                        </span>

                        <h2>
                            Informações da campanha
                        </h2>

                        <p>
                            Altere somente os dados necessários
                            e salve as modificações.
                        </p>

                    </div>


                    <% if (erro) { %>

                        <div class="mensagem erro">
                            <%= erro %>
                        </div>

                    <% } %>


                    <form
                        action="/admin/campanhas/<%= campanha.id %>/editar"
                        method="POST"
                        enctype="multipart/form-data"
                        class="formulario admin-formulario campanha-formulario-novo"
                    >

                        <!-- =========================================
                             IDENTIFICAÇÃO
                        ========================================== -->

                        <div class="campanha-form-bloco">

                            <div class="campanha-form-bloco-titulo">

                                <span>
                                    01
                                </span>

                                <div>

                                    <h3>
                                        Identificação
                                    </h3>

                                    <p>
                                        Atualize o título e a descrição
                                        da campanha.
                                    </p>

                                </div>

                            </div>


                            <div class="campo">

                                <label for="titulo">
                                    Título *
                                </label>

                                <input
                                    type="text"
                                    id="titulo"
                                    name="titulo"
                                    value="<%= campanha.titulo %>"
                                    maxlength="150"
                                    required
                                >

                                <small class="campo-ajuda">
                                    Use um título curto e fácil de identificar.
                                </small>

                            </div>


                            <div class="campo">

                                <label for="descricao">
                                    Descrição *
                                </label>

                                <textarea
                                    id="descricao"
                                    name="descricao"
                                    rows="6"
                                    required
                                ><%= campanha.descricao %></textarea>

                            </div>

                        </div>


                        <!-- =========================================
                             IMAGEM
                        ========================================== -->

                        <div class="campanha-form-bloco">

                            <div class="campanha-form-bloco-titulo">

                                <span>
                                    02
                                </span>

                                <div>

                                    <h3>
                                        Imagem da campanha
                                    </h3>

                                    <p>
                                        Visualize a imagem atual
                                        ou selecione uma nova.
                                    </p>

                                </div>

                            </div>


                            <% if (campanha.imagem) { %>

                                <div
                                    id="preview-container"
                                    class="campanha-preview campanha-preview-novo"
                                >

                                    <div class="campanha-preview-topo">

                                        <span
                                            id="preview-titulo"
                                            class="campanha-preview-titulo"
                                        >
                                            IMAGEM ATUAL
                                        </span>

                                        <strong>
                                            Campanha #<%= campanha.id %>
                                        </strong>

                                    </div>


                                    <img
                                        id="preview-imagem"
                                        src="/images/campanhas/<%= campanha.imagem %>"
                                        alt="Imagem da campanha <%= campanha.titulo %>"
                                    >

                                </div>

                            <% } else { %>

                                <div
                                    id="preview-container"
                                    class="campanha-preview campanha-preview-novo"
                                    hidden
                                >

                                    <div class="campanha-preview-topo">

                                        <span
                                            id="preview-titulo"
                                            class="campanha-preview-titulo"
                                        >
                                            PRÉ-VISUALIZAÇÃO
                                        </span>

                                        <strong>
                                            Nova imagem
                                        </strong>

                                    </div>


                                    <img
                                        id="preview-imagem"
                                        src=""
                                        alt="Pré-visualização da imagem da campanha"
                                    >

                                </div>


                                <div
                                    id="sem-imagem"
                                    class="campanha-editar-sem-imagem"
                                >

                                    <span>
                                        SEM IMAGEM
                                    </span>

                                    <p>
                                        Esta campanha ainda não possui
                                        uma imagem cadastrada.
                                    </p>

                                </div>

                            <% } %>


                            <div class="campo campanha-editar-upload">

                                <label for="imagem">
                                    Alterar imagem
                                </label>

                                <input
                                    type="file"
                                    id="imagem"
                                    name="imagem"
                                    accept="image/jpeg,image/png,image/webp"
                                >

                                <small class="campo-ajuda">
                                    Se nenhuma nova imagem for escolhida,
                                    a imagem atual será mantida.
                                    Formatos permitidos: JPG, PNG ou WEBP.
                                    Tamanho máximo: 5 MB.
                                </small>

                            </div>

                        </div>


                        <!-- =========================================
                             PERÍODO
                        ========================================== -->

                        <div class="campanha-form-bloco">

                            <div class="campanha-form-bloco-titulo">

                                <span>
                                    03
                                </span>

                                <div>

                                    <h3>
                                        Período
                                    </h3>

                                    <p>
                                        Atualize as datas de início
                                        e término da campanha.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-form-grid">

                                <div class="campo">

                                    <label for="data_inicio">
                                        Data de início *
                                    </label>

                                    <input
                                        type="date"
                                        id="data_inicio"
                                        name="data_inicio"
                                        value="<%= campanha.data_inicio %>"
                                        required
                                    >

                                </div>


                                <div class="campo">

                                    <label for="data_fim">
                                        Data de término
                                    </label>

                                    <input
                                        type="date"
                                        id="data_fim"
                                        name="data_fim"
                                        value="<%= campanha.data_fim || '' %>"
                                    >

                                    <small class="campo-ajuda">
                                        Deixe em branco caso a campanha
                                        ainda não tenha uma data final.
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- =========================================
                             META E STATUS
                        ========================================== -->

                        <div class="campanha-form-bloco">

                            <div class="campanha-form-bloco-titulo">

                                <span>
                                    04
                                </span>

                                <div>

                                    <h3>
                                        Meta e situação
                                    </h3>

                                    <p>
                                        Atualize a meta financeira
                                        e a situação da campanha.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-form-grid">

                                <div class="campo">

                                    <label for="meta">
                                        Meta em R$
                                    </label>

                                    <input
                                        type="number"
                                        id="meta"
                                        name="meta"
                                        step="0.01"
                                        min="0"
                                        value="<%= campanha.meta || '' %>"
                                        placeholder="0,00"
                                    >

                                    <small class="campo-ajuda">
                                        A meta financeira é opcional.
                                    </small>

                                </div>


                                <div class="campo">

                                    <label for="status">
                                        Status *
                                    </label>

                                    <select
                                        id="status"
                                        name="status"
                                        required
                                    >

                                        <option
                                            value="Ativa"
                                            <%= campanha.status === 'Ativa'
                                                ? 'selected'
                                                : '' %>
                                        >
                                            Ativa
                                        </option>

                                        <option
                                            value="Pausada"
                                            <%= campanha.status === 'Pausada'
                                                ? 'selected'
                                                : '' %>
                                        >
                                            Pausada
                                        </option>

                                        <option
                                            value="Encerrada"
                                            <%= campanha.status === 'Encerrada'
                                                ? 'selected'
                                                : '' %>
                                        >
                                            Encerrada
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>


                        <!-- =========================================
                             AÇÕES
                        ========================================== -->

                        <div class="admin-form-acoes campanha-form-acoes-novas">

                            <a
                                href="/admin/campanhas"
                                class="btn-secundario"
                            >
                                Cancelar
                            </a>

                            <button
                                type="submit"
                                class="btn-principal"
                            >
                                Salvar alterações
                            </button>

                        </div>

                    </form>

                </div>


                <!-- =================================================
                     PAINEL LATERAL
                ================================================== -->

                <aside class="campanha-form-lateral">

                    <div class="campanha-form-ajuda-card">

                        <span class="secao-etiqueta">
                            CAMPANHA
                        </span>

                        <h2>
                            Dados atuais
                        </h2>

                        <p>
                            Confira algumas informações
                            antes de realizar alterações.
                        </p>


                        <div class="campanha-form-ajuda-item">

                            <span>
                                01
                            </span>

                            <div>

                                <strong>
                                    Identificação
                                </strong>

                                <p>
                                    Campanha #<%= campanha.id %>
                                </p>

                            </div>

                        </div>


                        <div class="campanha-form-ajuda-item">

                            <span>
                                02
                            </span>

                            <div>

                                <strong>
                                    Imagem
                                </strong>

                                <p>
                                    <%= campanha.imagem
                                        ? 'A campanha possui uma imagem cadastrada.'
                                        : 'A campanha ainda não possui imagem.' %>
                                </p>

                            </div>

                        </div>


                        <div class="campanha-form-ajuda-item">

                            <span>
                                03
                            </span>

                            <div>

                                <strong>
                                    Meta
                                </strong>

                                <p>

                                    <% if (campanha.meta) { %>

                                        R$
                                        <%= Number(campanha.meta)
                                            .toFixed(2)
                                            .replace('.', ',') %>

                                    <% } else { %>

                                        Nenhuma meta financeira definida.

                                    <% } %>

                                </p>

                            </div>

                        </div>


                        <div class="campanha-form-ajuda-item">

                            <span>
                                04
                            </span>

                            <div>

                                <strong>
                                    Alterações
                                </strong>

                                <p>
                                    As novas informações serão exibidas
                                    depois que você salvar o formulário.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="campanha-form-status-card">

                        <span>
                            STATUS ATUAL
                        </span>

                        <strong>
                            <%= campanha.status %>
                        </strong>

                        <p>
                            Campanhas ativas são exibidas ao público.
                            Campanhas pausadas ou encerradas permanecem
                            registradas no painel administrativo.
                        </p>

                    </div>

                </aside>

            </div>

        </section>

    </main>

</div>


<script>

document.addEventListener(
    'DOMContentLoaded',
    () => {

        const inputImagem =
            document.getElementById('imagem');

        const previewContainer =
            document.getElementById(
                'preview-container'
            );

        const previewImagem =
            document.getElementById(
                'preview-imagem'
            );

        const previewTitulo =
            document.getElementById(
                'preview-titulo'
            );

        const semImagem =
            document.getElementById(
                'sem-imagem'
            );


        if (
            !inputImagem ||
            !previewContainer ||
            !previewImagem
        ) {
            return;
        }


        inputImagem.addEventListener(
            'change',
            () => {

                const arquivo =
                    inputImagem.files[0];


                if (!arquivo) {
                    return;
                }


                const tiposPermitidos = [

                    'image/jpeg',
                    'image/png',
                    'image/webp'

                ];


                if (
                    !tiposPermitidos.includes(
                        arquivo.type
                    )
                ) {

                    inputImagem.value = '';

                    alert(
                        'Selecione uma imagem JPG, PNG ou WEBP.'
                    );

                    return;
                }


                const limite =
                    5 * 1024 * 1024;


                if (arquivo.size > limite) {

                    inputImagem.value = '';

                    alert(
                        'A imagem deve ter no máximo 5 MB.'
                    );

                    return;
                }


                const leitor =
                    new FileReader();


                leitor.addEventListener(
                    'load',
                    () => {

                        previewImagem.src =
                            leitor.result;

                        previewContainer.hidden =
                            false;


                        if (previewTitulo) {

                            previewTitulo.textContent =
                                'NOVA IMAGEM';

                        }


                        if (semImagem) {

                            semImagem.hidden = true;

                        }

                    }
                );


                leitor.readAsDataURL(
                    arquivo
                );

            }
        );

    }
);

</script>

</body>
</html>