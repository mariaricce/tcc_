<header class="navbar">

    <div class="container navbar-container">

        <a href="/" class="logo">
            Instituto Solidarize
        </a>


        <button
            type="button"
            class="menu-toggle"
            id="menu-toggle"
            aria-label="Abrir menu"
            aria-controls="menu-principal"
            aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>


        <nav
            id="menu-principal"
            class="menu-principal"
            aria-label="Menu principal"
        >

            <a href="/">Home</a>

            <a href="/sobre">Sobre</a>

            <a href="/campanhas">Campanhas</a>

            <a href="/como-ajudar">Como Ajudar</a>

            <a href="/contato">Contato</a>


            <button
                type="button"
                id="toggle-tema"
                class="btn-tema"
            >
                Modo escuro
            </button>


            <% if (!usuarioLogado) { %>

                <a
                    href="/login"
                    class="btn-login"
                >
                    Login
                </a>

            <% } else { %>

                <% if (usuarioLogado.tipo === 'admin') { %>

                    <a
                        href="/admin"
                        class="link-painel"
                    >
                        Painel Admin
                    </a>

                <% } else { %>

                    <a
                        href="/usuario"
                        class="link-painel"
                    >
                        Minha Conta
                    </a>

                <% } %>


                <form
                    action="/logout"
                    method="POST"
                    class="form-logout-nav"
                >

                    <button
                        type="submit"
                        class="btn-sair-nav"
                    >
                        Sair
                    </button>

                </form>

            <% } %>

        </nav>

    </div>

</header>