<nav class="navbar">

    <div class="container navbar-container">

        <!-- LOGO -->

        <a
            href="/"
            class="logo logo-site"
            aria-label="Instituto Solidarize - Página inicial"
        >
            <img
                src="/images/logo-solidarize.png"
                alt="Instituto Solidarize"
                class="logo-imagem"
            >
        </a>


        <!-- BOTÃO MENU MOBILE -->

        <button
            type="button"
            class="menu-toggle"
            id="menu-toggle"
            aria-label="Abrir menu"
            aria-expanded="false"
            aria-controls="menu-principal"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>


        <!-- MENU -->

        <div
            class="menu-principal"
            id="menu-principal"
        >

            <a href="/">
                Home
            </a>

            <a href="/sobre">
                Sobre
            </a>

            <a href="/campanhas">
                Campanhas
            </a>

            <a href="/como-ajudar">
                Como Ajudar
            </a>

            <a href="/contato">
                Contato
            </a>


            <!-- MODO ESCURO -->

            <button
                type="button"
                class="btn-tema"
                id="btn-tema"
            >
                Modo escuro
            </button>


            <%
                const usuarioAtual =
                    typeof usuarioLogado !== 'undefined'
                        ? usuarioLogado
                        : (
                            typeof usuario !== 'undefined'
                                ? usuario
                                : null
                        );
            %>


            <!-- USUÁRIO LOGADO -->

            <% if (usuarioAtual) { %>

                <% if (usuarioAtual.tipo === 'admin') { %>

                    <a
                        href="/admin"
                        class="link-painel"
                    >
                        Painel Admin
                    </a>

                <% } else { %>

                    <a
                        href="/usuario/painel"
                        class="link-painel"
                    >
                        Minha conta
                    </a>

                <% } %>


                <form
                    action="/logout"
                    method="POST"
                    class="form-logout-nav"
                >

                    <button
                        type="submit"
                        class="btn-sair-nav"
                    >
                        Sair
                    </button>

                </form>


            <% } else { %>

                <a
                    href="/login"
                    class="btn-login"
                >
                    Login
                </a>

            <% } %>

        </div>

    </div>

</nav>