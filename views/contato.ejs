<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="contato-page">

    <section class="pagina-topo">

        <div class="container">

            <span class="secao-etiqueta">
                FALE CONOSCO
            </span>

            <h1>
                Entre em contato
            </h1>

            <p>
                Tem alguma dúvida sobre nossas campanhas,
                doações ou trabalho voluntário? Entre em contato
                com o Instituto Solidarize.
            </p>

        </div>

    </section>


    <section class="contato-conteudo">

        <div class="container">

            <div class="contato-grid">


                <!-- APRESENTAÇÃO -->

                <div class="contato-informacoes">

                    <span class="secao-etiqueta">
                        CONTATO
                    </span>

                    <h2>
                        Estamos à disposição para ajudar
                    </h2>

                    <p>
                        Nosso objetivo é facilitar a comunicação entre
                        a comunidade, voluntários, doadores e o Instituto
                        Solidarize.
                    </p>

                    <p>
                        Você pode entrar em contato para tirar dúvidas,
                        conhecer nossas ações ou obter mais informações
                        sobre como participar.
                    </p>


                    <div class="contato-opcoes">

                        <div class="contato-opcao">

                            <span>
                                Campanhas
                            </span>

                            <p>
                                Tire dúvidas sobre campanhas e ações
                                realizadas pelo Instituto.
                            </p>

                            <a href="/campanhas">
                                Conhecer campanhas
                            </a>

                        </div>


                        <div class="contato-opcao">

                            <span>
                                Voluntariado
                            </span>

                            <p>
                                Saiba como participar das nossas ações
                                como voluntário.
                            </p>

                            <a href="/quero-ser-voluntario">
                                Quero ser voluntário
                            </a>

                        </div>


                        <div class="contato-opcao">

                            <span>
                                Doações
                            </span>

                            <p>
                                Conheça as diferentes maneiras de
                                contribuir com nossas ações sociais.
                            </p>

                            <a href="/como-ajudar">
                                Como ajudar
                            </a>

                        </div>

                    </div>

                </div>


                <!-- FORMULÁRIO -->

                <div class="contato-form-card">

                    <span class="secao-etiqueta">
                        MENSAGEM
                    </span>

                    <h2>
                        Envie sua mensagem
                    </h2>

                    <p class="contato-form-texto">
                        Preencha os campos abaixo para entrar em contato
                        com nossa equipe.
                    </p>


                    <% if (typeof sucesso !== 'undefined' && sucesso) { %>

                        <div class="mensagem sucesso">
                            Mensagem enviada com sucesso.
                            Em breve entraremos em contato.
                        </div>

                    <% } %>


                    <% if (typeof erro !== 'undefined' && erro) { %>

                        <div class="mensagem erro">
                            Não foi possível enviar sua mensagem.
                            Tente novamente.
                        </div>

                    <% } %>


                    <form
                        action="/contato"
                        method="POST"
                        class="formulario contato-formulario"
                    >

                        <div class="campo">

                            <label for="contato_nome">
                                Nome
                            </label>

                            <input
                                type="text"
                                id="contato_nome"
                                name="nome"
                                placeholder="Digite seu nome"
                                required
                            >

                        </div>


                        <div class="campo">

                            <label for="contato_email">
                                E-mail
                            </label>

                            <input
                                type="email"
                                id="contato_email"
                                name="email"
                                placeholder="exemplo@email.com"
                                required
                            >

                        </div>


                        <div class="campo">

                            <label for="contato_assunto">
                                Assunto
                            </label>

                            <select
                                id="contato_assunto"
                                name="assunto"
                                required
                            >

                                <option value="">
                                    Selecione
                                </option>

                                <option value="Campanhas">
                                    Campanhas
                                </option>

                                <option value="Voluntariado">
                                    Voluntariado
                                </option>

                                <option value="Doacoes">
                                    Doações
                                </option>

                                <option value="Outros">
                                    Outros
                                </option>

                            </select>

                        </div>


                        <div class="campo">

                            <label for="contato_mensagem">
                                Mensagem
                            </label>

                            <textarea
                                id="contato_mensagem"
                                name="mensagem"
                                rows="6"
                                placeholder="Digite sua mensagem"
                                required
                            ></textarea>

                        </div>


                        <button
                            type="submit"
                            class="btn-principal contato-btn"
                        >
                            Enviar mensagem
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </section>


    <section class="contato-final">

        <div class="container">

            <div class="contato-final-box">

                <span class="secao-etiqueta">
                    SOLIDARIZE
                </span>

                <h2>
                    Toda forma de participação é importante
                </h2>

                <p>
                    Conheça nossas campanhas e descubra como você
                    também pode contribuir com as ações do Instituto.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/campanhas"
                        class="btn-principal"
                    >
                        Ver campanhas
                    </a>

                    <a
                        href="/como-ajudar"
                        class="btn-secundario"
                    >
                        Como ajudar
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>