<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo admin-conteudo-novo">

        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <header class="admin-topo-novo">

            <div class="admin-topo-texto">

                <span class="secao-etiqueta">
                    PAINEL ADMINISTRATIVO
                </span>

                <h1>
                    Visão geral do Instituto
                </h1>

                <p>
                    Bem-vindo,
                    <strong><%= usuario.nome %></strong>.
                    Acompanhe os principais dados e gerencie
                    as atividades do Instituto Solidarize.
                </p>

            </div>


            <div class="admin-perfil-novo">

                <div class="admin-avatar-novo">
                    <%= usuario.nome.charAt(0).toUpperCase() %>
                </div>

                <div>

                    <span>
                        ADMINISTRADOR
                    </span>

                    <strong>
                        <%= usuario.nome %>
                    </strong>

                </div>

            </div>

        </header>


        <section class="admin-dashboard admin-dashboard-novo">

            <!-- =================================================
                 RESUMO
            ================================================== -->

            <section class="admin-resumo-novo">

                <div class="admin-secao-cabecalho-novo">

                    <div>

                        <span class="secao-etiqueta">
                            VISÃO GERAL
                        </span>

                        <h2>
                            Resumo do sistema
                        </h2>

                        <p>
                            Principais registros cadastrados
                            atualmente no Instituto.
                        </p>

                    </div>

                </div>


                <div class="admin-indicadores-grid">


                    <!-- CAMPANHAS -->

                    <a
                        href="/admin/campanhas"
                        class="admin-indicador-card"
                    >

                        <div class="admin-indicador-topo">

                            <span class="admin-indicador-numero">
                                01
                            </span>

                            <span class="admin-indicador-link">
                                Gerenciar
                            </span>

                        </div>

                        <span class="admin-indicador-label">
                            CAMPANHAS
                        </span>

                        <strong class="admin-indicador-valor">
                            <%= totais.campanhas %>
                        </strong>

                        <p>
                            Campanhas ativas
                        </p>

                    </a>


                    <!-- VOLUNTÁRIOS -->

                    <a
                        href="/admin/voluntarios"
                        class="admin-indicador-card"
                    >

                        <div class="admin-indicador-topo">

                            <span class="admin-indicador-numero">
                                02
                            </span>

                            <span class="admin-indicador-link">
                                Gerenciar
                            </span>

                        </div>

                        <span class="admin-indicador-label">
                            VOLUNTÁRIOS
                        </span>

                        <strong class="admin-indicador-valor">
                            <%= totais.voluntarios %>
                        </strong>

                        <p>
                            Pessoas cadastradas
                        </p>

                    </a>


                    <!-- BENEFICIÁRIOS -->

                    <a
                        href="/admin/beneficiarios"
                        class="admin-indicador-card"
                    >

                        <div class="admin-indicador-topo">

                            <span class="admin-indicador-numero">
                                03
                            </span>

                            <span class="admin-indicador-link">
                                Gerenciar
                            </span>

                        </div>

                        <span class="admin-indicador-label">
                            BENEFICIÁRIOS
                        </span>

                        <strong class="admin-indicador-valor">
                            <%= totais.beneficiarios %>
                        </strong>

                        <p>
                            Beneficiários cadastrados
                        </p>

                    </a>


                    <!-- DOAÇÕES -->

                    <a
                        href="/admin/doacoes"
                        class="admin-indicador-card"
                    >

                        <div class="admin-indicador-topo">

                            <span class="admin-indicador-numero">
                                04
                            </span>

                            <span class="admin-indicador-link">
                                Gerenciar
                            </span>

                        </div>

                        <span class="admin-indicador-label">
                            DOAÇÕES
                        </span>

                        <strong class="admin-indicador-valor">
                            <%= totais.doacoes %>
                        </strong>

                        <p>
                            Doações registradas
                        </p>

                    </a>

                </div>

            </section>


            <!-- =================================================
                 ACESSO RÁPIDO
            ================================================== -->

            <section class="admin-dashboard-secao-nova">

                <div class="admin-secao-cabecalho-novo">

                    <div>

                        <span class="secao-etiqueta">
                            GERENCIAMENTO
                        </span>

                        <h2>
                            Acesso rápido
                        </h2>

                        <p>
                            Cadastre novos registros diretamente
                            pelas principais áreas administrativas.
                        </p>

                    </div>

                </div>


                <div class="admin-acoes-novas">


                    <a
                        href="/admin/campanhas/nova"
                        class="admin-acao-nova"
                    >

                        <span>
                            01
                        </span>

                        <div>

                            <strong>
                                Nova campanha
                            </strong>

                            <small>
                                Cadastrar uma nova campanha
                            </small>

                        </div>

                    </a>


                    <a
                        href="/admin/voluntarios/novo"
                        class="admin-acao-nova"
                    >

                        <span>
                            02
                        </span>

                        <div>

                            <strong>
                                Novo voluntário
                            </strong>

                            <small>
                                Cadastrar um novo voluntário
                            </small>

                        </div>

                    </a>


                    <a
                        href="/admin/beneficiarios/novo"
                        class="admin-acao-nova"
                    >

                        <span>
                            03
                        </span>

                        <div>

                            <strong>
                                Novo beneficiário
                            </strong>

                            <small>
                                Cadastrar um beneficiário
                            </small>

                        </div>

                    </a>


                    <a
                        href="/admin/doacoes/nova"
                        class="admin-acao-nova"
                    >

                        <span>
                            04
                        </span>

                        <div>

                            <strong>
                                Nova doação
                            </strong>

                            <small>
                                Registrar uma nova doação
                            </small>

                        </div>

                    </a>


                    <a
                        href="/admin/participacoes/nova"
                        class="admin-acao-nova"
                    >

                        <span>
                            05
                        </span>

                        <div>

                            <strong>
                                Nova participação
                            </strong>

                            <small>
                                Vincular voluntário e campanha
                            </small>

                        </div>

                    </a>


                    <a
                        href="/admin/atendimentos/novo"
                        class="admin-acao-nova"
                    >

                        <span>
                            06
                        </span>

                        <div>

                            <strong>
                                Novo atendimento
                            </strong>

                            <small>
                                Registrar um atendimento
                            </small>

                        </div>

                    </a>

                </div>

            </section>


            <!-- =================================================
                 REGISTROS RECENTES
            ================================================== -->

            <section class="admin-registros-recentes">

                <div class="admin-secao-cabecalho-novo">

                    <div>

                        <span class="secao-etiqueta">
                            ATIVIDADE RECENTE
                        </span>

                        <h2>
                            Últimos registros
                        </h2>

                        <p>
                            Acompanhe as movimentações
                            recentes do sistema.
                        </p>

                    </div>

                </div>


                <div class="admin-registros-grid">


                    <!-- =========================================
                         DOAÇÕES
                    ========================================== -->

                    <article class="admin-registro-card">

                        <div class="admin-registro-card-topo">

                            <div>

                                <span class="admin-registro-tipo">
                                    DOAÇÕES
                                </span>

                                <h3>
                                    Últimas doações
                                </h3>

                            </div>

                            <a
                                href="/admin/doacoes"
                                class="admin-ver-todos"
                            >
                                Ver todas
                            </a>

                        </div>


                        <% if (ultimasDoacoes.length === 0) { %>

                            <div class="admin-vazio admin-vazio-novo">

                                <h3>
                                    Nenhuma doação cadastrada
                                </h3>

                                <p>
                                    As doações registradas
                                    aparecerão aqui.
                                </p>

                            </div>

                        <% } else { %>

                            <div class="tabela-container admin-tabela-nova">

                                <table>

                                    <thead>

                                        <tr>
                                            <th>Doador</th>
                                            <th>Tipo</th>
                                            <th>Valor</th>
                                            <th>Data</th>
                                        </tr>

                                    </thead>


                                    <tbody>

                                        <% ultimasDoacoes.forEach(doacao => { %>

                                            <tr>

                                                <td>
                                                    <strong>
                                                        <%= doacao.doador_nome %>
                                                    </strong>
                                                </td>

                                                <td>
                                                    <%= doacao.tipo %>
                                                </td>

                                                <td>

                                                    <% if (doacao.valor !== null) { %>

                                                        <span class="admin-valor-doacao">

                                                            R$
                                                            <%= Number(doacao.valor)
                                                                .toFixed(2)
                                                                .replace('.', ',') %>

                                                        </span>

                                                    <% } else { %>

                                                        -

                                                    <% } %>

                                                </td>

                                                <td>

                                                    <%= new Date(
                                                        doacao.data_doacao
                                                    ).toLocaleDateString('pt-BR') %>

                                                </td>

                                            </tr>

                                        <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        <% } %>

                    </article>


                    <!-- =========================================
                         VOLUNTÁRIOS
                    ========================================== -->

                    <article class="admin-registro-card">

                        <div class="admin-registro-card-topo">

                            <div>

                                <span class="admin-registro-tipo">
                                    VOLUNTÁRIOS
                                </span>

                                <h3>
                                    Últimos voluntários
                                </h3>

                            </div>

                            <a
                                href="/admin/voluntarios"
                                class="admin-ver-todos"
                            >
                                Ver todos
                            </a>

                        </div>


                        <% if (ultimosVoluntarios.length === 0) { %>

                            <div class="admin-vazio admin-vazio-novo">

                                <h3>
                                    Nenhum voluntário cadastrado
                                </h3>

                                <p>
                                    Os novos voluntários
                                    aparecerão aqui.
                                </p>

                            </div>

                        <% } else { %>

                            <div class="tabela-container admin-tabela-nova">

                                <table>

                                    <thead>

                                        <tr>
                                            <th>Nome</th>
                                            <th>E-mail</th>
                                            <th>Status</th>
                                        </tr>

                                    </thead>


                                    <tbody>

                                        <% ultimosVoluntarios.forEach(voluntario => { %>

                                            <tr>

                                                <td>
                                                    <strong>
                                                        <%= voluntario.nome %>
                                                    </strong>
                                                </td>

                                                <td>
                                                    <%= voluntario.email %>
                                                </td>

                                                <td>

                                                    <span class="status-admin">
                                                        <%= voluntario.status %>
                                                    </span>

                                                </td>

                                            </tr>

                                        <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        <% } %>

                    </article>

                </div>

            </section>


            <!-- =================================================
                 RODAPÉ DO DASHBOARD
            ================================================== -->

            <section class="admin-dashboard-final">

                <div>

                    <span class="secao-etiqueta">
                        INSTITUTO SOLIDARIZE
                    </span>

                    <h2>
                        Gestão organizada para fortalecer nossas ações
                    </h2>

                    <p>
                        Utilize o painel para acompanhar registros
                        e manter as informações do Instituto atualizadas.
                    </p>

                </div>


                <a
                    href="/"
                    class="btn-secundario"
                >
                    Visualizar site
                </a>

            </section>

        </section>

    </main>

</div>

</body>
</html>