<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="sobre-page">

    <section class="pagina-topo">

        <div class="container">

            <span class="secao-etiqueta">
                SOBRE NÓS
            </span>

            <h1>
                Conheça o Instituto Solidarize
            </h1>

            <p>
                Uma iniciativa criada para aproximar pessoas,
                fortalecer a solidariedade e apoiar quem mais precisa.
            </p>

        </div>

    </section>


    <section class="sobre-historia">

        <div class="container">

            <div class="sobre-historia-grid">

                <div>

                    <span class="secao-etiqueta">
                        NOSSA HISTÓRIA
                    </span>

                    <h2>
                        Solidariedade que aproxima pessoas
                    </h2>

                    <p>
                        O Instituto Solidarize nasceu com o objetivo
                        de contribuir com a comunidade por meio de
                        ações sociais, campanhas e projetos de apoio.
                    </p>

                    <p>
                        Nossa proposta é conectar pessoas que desejam
                        ajudar com pessoas que precisam de apoio,
                        promovendo uma rede de solidariedade,
                        participação e transformação social.
                    </p>

                    <p>
                        Por meio da tecnologia, buscamos organizar
                        melhor nossas campanhas, voluntários,
                        doações, beneficiários e atendimentos.
                    </p>

                </div>


                <div class="sobre-destaque">

                    <span class="secao-etiqueta">
                        NOSSO PROPÓSITO
                    </span>

                    <h3>
                        Juntos fazemos a diferença
                    </h3>

                    <p>
                        Cada pessoa pode contribuir de alguma forma:
                        doando, participando, divulgando ou oferecendo
                        seu tempo como voluntário.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <section class="sobre-principios">

        <div class="container">

            <div class="home-secao-cabecalho">

                <span class="secao-etiqueta">
                    NOSSOS PRINCÍPIOS
                </span>

                <h2>
                    O que orienta nosso trabalho
                </h2>

                <p>
                    Conheça os princípios que representam
                    o Instituto Solidarize.
                </p>

            </div>


            <div class="sobre-cards">

                <div class="sobre-card">

                    <h3>Missão</h3>

                    <p>
                        Promover ações de solidariedade e apoio social,
                        conectando pessoas e contribuindo para melhorar
                        a qualidade de vida da comunidade.
                    </p>

                </div>


                <div class="sobre-card">

                    <h3>Visão</h3>

                    <p>
                        Ser uma instituição reconhecida pelo compromisso
                        social, pela organização e pelo impacto positivo
                        de suas ações.
                    </p>

                </div>


                <div class="sobre-card">

                    <h3>Valores</h3>

                    <p>
                        Solidariedade, respeito, empatia,
                        responsabilidade, transparência, inclusão
                        e compromisso com a comunidade.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <section class="sobre-atuacao">

        <div class="container">

            <div class="sobre-atuacao-conteudo">

                <div>

                    <span class="secao-etiqueta">
                        COMO ATUAMOS
                    </span>

                    <h2>
                        Ações que geram impacto
                    </h2>

                    <p>
                        O Instituto desenvolve diferentes formas
                        de apoio à comunidade.
                    </p>

                </div>


                <div class="sobre-lista">

                    <div>
                        <p>
                            Campanhas sociais e de arrecadação
                        </p>
                    </div>

                    <div>
                        <p>
                            Recebimento e organização de doações
                        </p>
                    </div>

                    <div>
                        <p>
                            Participação de voluntários
                        </p>
                    </div>

                    <div>
                        <p>
                            Apoio e atendimento aos beneficiários
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <section class="home-cta">

        <div class="container">

            <div class="home-cta-box">

                <span class="secao-etiqueta">
                    PARTICIPE
                </span>

                <h2>
                    Faça parte dessa história
                </h2>

                <p>
                    Sua participação também pode contribuir
                    para transformar vidas e fortalecer nossa comunidade.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/como-ajudar"
                        class="btn-principal"
                    >
                        Quero ajudar
                    </a>

                    <a
                        href="/campanhas"
                        class="btn-secundario"
                    >
                        Ver campanhas
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>