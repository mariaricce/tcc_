<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="sobre-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="sobre-hero-novo">

        <div class="container sobre-hero-grid">

            <div class="sobre-hero-conteudo">

                <span class="secao-etiqueta">
                    SOBRE O INSTITUTO
                </span>

                <h1>
                    Solidariedade que aproxima
                    <span>pessoas</span>
                </h1>

                <p>
                    O Instituto Solidarize nasceu com o propósito
                    de conectar pessoas, organizar ações sociais
                    e apoiar quem mais precisa.
                </p>

            </div>


            <div class="sobre-hero-destaque">

                <span class="sobre-hero-destaque-numero">
                    SOLIDARIZE
                </span>

                <h2>
                    Juntos podemos transformar realidades
                </h2>

                <p>
                    Acreditamos que pequenas ações,
                    quando realizadas em conjunto,
                    podem gerar grandes mudanças.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         NOSSA HISTÓRIA
    ====================================================== -->

    <section class="sobre-historia-nova">

        <div class="container sobre-historia-nova-grid">

            <div class="sobre-historia-titulo">

                <span class="secao-etiqueta">
                    NOSSA HISTÓRIA
                </span>

                <h2>
                    Um projeto criado para fazer a diferença
                </h2>

            </div>


            <div class="sobre-historia-texto">

                <p>
                    O Instituto Solidarize nasceu com o objetivo
                    de contribuir com a comunidade por meio de
                    ações sociais, campanhas e projetos de apoio.
                </p>

                <p>
                    Nossa proposta é conectar pessoas que desejam
                    ajudar com pessoas que precisam de apoio,
                    promovendo uma rede de solidariedade,
                    participação e transformação social.
                </p>

                <p>
                    Por meio da tecnologia, buscamos organizar
                    melhor nossas campanhas, voluntários,
                    doações, beneficiários e atendimentos.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PROPÓSITO
    ====================================================== -->

    <section class="sobre-proposito">

        <div class="container">

            <div class="sobre-proposito-card">

                <div>

                    <span class="secao-etiqueta">
                        NOSSO PROPÓSITO
                    </span>

                    <h2>
                        Cada pessoa pode contribuir de alguma forma
                    </h2>

                </div>


                <div>

                    <p>
                        Seja por meio de uma doação, participando
                        de uma campanha, divulgando nossas ações
                        ou oferecendo seu tempo como voluntário.
                    </p>

                    <p>
                        O mais importante é transformar a vontade
                        de ajudar em uma ação capaz de gerar impacto
                        positivo na comunidade.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PRINCÍPIOS
    ====================================================== -->

    <section class="sobre-principios-novo">

        <div class="container">

            <div class="home-secao-cabecalho">

                <span class="secao-etiqueta">
                    NOSSOS PRINCÍPIOS
                </span>

                <h2>
                    O que orienta nosso trabalho
                </h2>

                <p>
                    Missão, visão e valores que representam
                    o Instituto Solidarize.
                </p>

            </div>


            <div class="sobre-principios-grid">

                <article class="sobre-principio-card">

                    <span class="sobre-principio-numero">
                        01
                    </span>

                    <h3>
                        Missão
                    </h3>

                    <p>
                        Promover ações de solidariedade e apoio
                        social, conectando pessoas e contribuindo
                        para melhorar a qualidade de vida da
                        comunidade.
                    </p>

                </article>


                <article class="sobre-principio-card">

                    <span class="sobre-principio-numero">
                        02
                    </span>

                    <h3>
                        Visão
                    </h3>

                    <p>
                        Ser uma instituição reconhecida pelo
                        compromisso social, pela organização
                        e pelo impacto positivo de suas ações.
                    </p>

                </article>


                <article class="sobre-principio-card">

                    <span class="sobre-principio-numero">
                        03
                    </span>

                    <h3>
                        Valores
                    </h3>

                    <p>
                        Solidariedade, respeito, empatia,
                        responsabilidade, transparência,
                        inclusão e compromisso com a comunidade.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- =====================================================
         COMO ATUAMOS
    ====================================================== -->

    <section class="sobre-atuacao-nova">

        <div class="container sobre-atuacao-grid">

            <div class="sobre-atuacao-intro">

                <span class="secao-etiqueta">
                    COMO ATUAMOS
                </span>

                <h2>
                    Ações que geram impacto
                </h2>

                <p>
                    O Instituto Solidarize desenvolve diferentes
                    formas de apoio e participação para aproximar
                    pessoas e fortalecer a comunidade.
                </p>

                <a
                    href="/campanhas"
                    class="btn-principal"
                >
                    Conhecer campanhas
                </a>

            </div>


            <div class="sobre-atuacao-lista">

                <div class="sobre-atuacao-item">

                    <span>
                        01
                    </span>

                    <div>

                        <h3>
                            Campanhas sociais
                        </h3>

                        <p>
                            Criação e organização de campanhas
                            voltadas às necessidades da comunidade.
                        </p>

                    </div>

                </div>


                <div class="sobre-atuacao-item">

                    <span>
                        02
                    </span>

                    <div>

                        <h3>
                            Doações
                        </h3>

                        <p>
                            Recebimento e organização de contribuições
                            destinadas às ações do Instituto.
                        </p>

                    </div>

                </div>


                <div class="sobre-atuacao-item">

                    <span>
                        03
                    </span>

                    <div>

                        <h3>
                            Voluntariado
                        </h3>

                        <p>
                            Participação de pessoas dispostas a doar
                            tempo e colaborar com nossas ações.
                        </p>

                    </div>

                </div>


                <div class="sobre-atuacao-item">

                    <span>
                        04
                    </span>

                    <div>

                        <h3>
                            Atendimento
                        </h3>

                        <p>
                            Organização do apoio prestado aos
                            beneficiários acompanhados pelo Instituto.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CHAMADA FINAL
    ====================================================== -->

    <section class="home-cta">

        <div class="container">

            <div class="home-cta-box">

                <span class="secao-etiqueta">
                    PARTICIPE
                </span>

                <h2>
                    Faça parte dessa história
                </h2>

                <p>
                    Sua participação também pode contribuir
                    para transformar vidas e fortalecer nossa
                    comunidade.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/como-ajudar"
                        class="btn-principal"
                    >
                        Quero ajudar
                    </a>

                    <a
                        href="/campanhas"
                        class="btn-secundario"
                    >
                        Ver campanhas
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>