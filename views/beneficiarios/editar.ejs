<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo admin-conteudo-novo">

        <!-- =====================================================
             CABEÇALHO
        ====================================================== -->

        <header class="admin-form-topo-novo">

            <div>

                <span class="secao-etiqueta">
                    BENEFICIÁRIOS
                </span>

                <h1>
                    Editar beneficiário
                </h1>

                <p>
                    Atualize as informações de
                    <strong><%= beneficiario.nome %></strong>
                    no Instituto Solidarize.
                </p>

            </div>


            <a
                href="/admin/beneficiarios"
                class="btn-secundario"
            >
                Voltar para beneficiários
            </a>

        </header>


        <!-- =====================================================
             CONTEÚDO
        ====================================================== -->

        <section class="beneficiario-form-area">

            <div class="beneficiario-form-grid-novo">


                <!-- =================================================
                     FORMULÁRIO
                ================================================== -->

                <div class="beneficiario-form-principal">

                    <div class="beneficiario-form-cabecalho">

                        <span class="secao-etiqueta">
                            EDITAR CADASTRO
                        </span>

                        <h2>
                            Informações do beneficiário
                        </h2>

                        <p>
                            Altere somente os dados necessários
                            e salve as modificações.
                        </p>

                    </div>


                    <% if (typeof erro !== 'undefined' && erro) { %>

                        <div class="mensagem erro">
                            <%= erro %>
                        </div>

                    <% } %>


                    <form
                        action="/admin/beneficiarios/<%= beneficiario.id %>/editar"
                        method="POST"
                        class="formulario admin-formulario beneficiario-formulario-novo"
                    >

                        <!-- =========================================
                             IDENTIFICAÇÃO
                        ========================================== -->

                        <div class="beneficiario-form-bloco">

                            <div class="beneficiario-form-bloco-titulo">

                                <span>
                                    01
                                </span>

                                <div>

                                    <h3>
                                        Identificação e contato
                                    </h3>

                                    <p>
                                        Atualize o nome e os dados
                                        de contato do beneficiário.
                                    </p>

                                </div>

                            </div>


                            <div class="admin-form-grid">

                                <div class="campo">

                                    <label for="nome">
                                        Nome completo *
                                    </label>

                                    <input
                                        type="text"
                                        id="nome"
                                        name="nome"
                                        value="<%= beneficiario.nome %>"
                                        autocomplete="name"
                                        required
                                    >

                                </div>


                                <div class="campo">

                                    <label for="telefone">
                                        Telefone
                                    </label>

                                    <input
                                        type="text"
                                        id="telefone"
                                        name="telefone"
                                        value="<%= beneficiario.telefone || '' %>"
                                        placeholder="(00) 00000-0000"
                                        autocomplete="tel"
                                    >

                                </div>

                            </div>

                        </div>


                        <!-- =========================================
                             INFORMAÇÕES ADICIONAIS
                        ========================================== -->

                        <div class="beneficiario-form-bloco">

                            <div class="beneficiario-form-bloco-titulo">

                                <span>
                                    02
                                </span>

                                <div>

                                    <h3>
                                        Informações adicionais
                                    </h3>

                                    <p>
                                        Atualize o endereço
                                        e as observações do cadastro.
                                    </p>

                                </div>

                            </div>


                            <div class="campo">

                                <label for="endereco">
                                    Endereço
                                </label>

                                <input
                                    type="text"
                                    id="endereco"
                                    name="endereco"
                                    value="<%= beneficiario.endereco || '' %>"
                                    placeholder="Rua, número, bairro e cidade"
                                    autocomplete="street-address"
                                >

                                <small class="campo-ajuda">
                                    Mantenha o endereço atualizado
                                    quando essa informação estiver disponível.
                                </small>

                            </div>


                            <div class="campo">

                                <label for="observacoes">
                                    Observações
                                </label>

                                <textarea
                                    id="observacoes"
                                    name="observacoes"
                                    rows="6"
                                    placeholder="Informações adicionais sobre o beneficiário"
                                ><%= beneficiario.observacoes || '' %></textarea>

                                <small class="campo-ajuda">
                                    Registre somente informações relevantes
                                    para o acompanhamento do beneficiário.
                                </small>

                            </div>

                        </div>


                        <!-- =========================================
                             STATUS
                        ========================================== -->

                        <div class="beneficiario-form-bloco">

                            <div class="beneficiario-form-bloco-titulo">

                                <span>
                                    03
                                </span>

                                <div>

                                    <h3>
                                        Situação do cadastro
                                    </h3>

                                    <p>
                                        Defina se o beneficiário
                                        permanece ativo no sistema.
                                    </p>

                                </div>

                            </div>


                            <div class="campo">

                                <label for="status">
                                    Status *
                                </label>

                                <select
                                    id="status"
                                    name="status"
                                    required
                                >

                                    <option
                                        value="Ativo"
                                        <%= beneficiario.status === 'Ativo'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        Ativo
                                    </option>

                                    <option
                                        value="Inativo"
                                        <%= beneficiario.status === 'Inativo'
                                            ? 'selected'
                                            : '' %>
                                    >
                                        Inativo
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- =========================================
                             AÇÕES
                        ========================================== -->

                        <div class="admin-form-acoes beneficiario-form-acoes-novas">

                            <a
                                href="/admin/beneficiarios"
                                class="btn-secundario"
                            >
                                Cancelar
                            </a>

                            <button
                                type="submit"
                                class="btn-principal"
                            >
                                Salvar alterações
                            </button>

                        </div>

                    </form>

                </div>


                <!-- =================================================
                     PAINEL LATERAL
                ================================================== -->

                <aside class="beneficiario-form-lateral">

                    <div class="beneficiario-form-ajuda-card">

                        <span class="secao-etiqueta">
                            BENEFICIÁRIO
                        </span>

                        <h2>
                            Dados atuais
                        </h2>

                        <p>
                            Confira algumas informações
                            antes de realizar alterações.
                        </p>


                        <div class="beneficiario-form-ajuda-item">

                            <span>
                                01
                            </span>

                            <div>

                                <strong>
                                    Identificação
                                </strong>

                                <p>
                                    Beneficiário #<%= beneficiario.id %>
                                </p>

                            </div>

                        </div>


                        <div class="beneficiario-form-ajuda-item">

                            <span>
                                02
                            </span>

                            <div>

                                <strong>
                                    Telefone
                                </strong>

                                <p>
                                    <%= beneficiario.telefone
                                        || 'Não informado' %>
                                </p>

                            </div>

                        </div>


                        <div class="beneficiario-form-ajuda-item">

                            <span>
                                03
                            </span>

                            <div>

                                <strong>
                                    Endereço
                                </strong>

                                <p>
                                    <%= beneficiario.endereco
                                        || 'Não informado' %>
                                </p>

                            </div>

                        </div>


                        <div class="beneficiario-form-ajuda-item">

                            <span>
                                04
                            </span>

                            <div>

                                <strong>
                                    Alterações
                                </strong>

                                <p>
                                    Os novos dados serão atualizados
                                    após salvar o formulário.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="beneficiario-form-status-card">

                        <span>
                            STATUS ATUAL
                        </span>

                        <strong>
                            <%= beneficiario.status %>
                        </strong>

                        <p>
                            Beneficiários inativos permanecem
                            cadastrados no sistema e podem
                            ser reativados posteriormente.
                        </p>

                    </div>

                </aside>

            </div>

        </section>

    </main>

</div>

</body>
</html>