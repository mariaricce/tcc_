<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="pagina como-ajudar-page">

    <section class="pagina-topo">

        <div class="container">

            <span class="secao-etiqueta">
                PARTICIPE
            </span>

            <h1>
                Como Ajudar
            </h1>

            <p>
                Existem diferentes maneiras de fazer parte do
                Instituto Solidarize e contribuir com nossas ações.
            </p>

        </div>

    </section>


    <section class="conteudo-pagina">

        <div class="container">

            <div class="cards-ajudar">


                <div class="card-ajudar">

                    <span class="secao-etiqueta">
                        VOLUNTARIADO
                    </span>

                    <h3>
                        Seja voluntário
                    </h3>

                    <p>
                        Participe das nossas ações e contribua
                        com seu tempo e suas habilidades.
                    </p>

                    <a
                        href="/quero-ser-voluntario"
                        class="btn-principal"
                    >
                        Quero ser voluntário
                    </a>

                </div>


                <div class="card-ajudar">

                    <span class="secao-etiqueta">
                        DOAÇÕES
                    </span>

                    <h3>
                        Faça uma doação
                    </h3>

                    <p>
                        Alimentos, roupas, materiais e outras
                        doações podem fazer a diferença na
                        vida de muitas pessoas.
                    </p>

                    <a
                        href="/campanhas"
                        class="btn-secundario"
                    >
                        Ver campanhas
                    </a>

                </div>


                <div class="card-ajudar">

                    <span class="secao-etiqueta">
                        DIVULGAÇÃO
                    </span>

                    <h3>
                        Compartilhe nossas ações
                    </h3>

                    <p>
                        Divulgue nossas campanhas e ajude
                        nossas iniciativas a alcançar cada vez
                        mais pessoas.
                    </p>

                    <a
                        href="/campanhas"
                        class="btn-secundario"
                    >
                        Conhecer campanhas
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>