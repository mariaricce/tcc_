<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="como-ajudar-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="ajudar-hero">

        <div class="container ajudar-hero-grid">

            <div class="ajudar-hero-conteudo">

                <span class="secao-etiqueta">
                    PARTICIPE
                </span>

                <h1>
                    Existem várias formas de
                    <span>transformar</span>
                </h1>

                <p>
                    Você pode contribuir com o Instituto Solidarize
                    de diferentes maneiras. Cada gesto de apoio pode
                    ajudar nossas ações a alcançar ainda mais pessoas.
                </p>

                <a
                    href="/campanhas"
                    class="btn-principal"
                >
                    Ver campanhas
                </a>

            </div>


            <div class="ajudar-hero-destaque">

                <span class="ajudar-hero-numero">
                    SUA AJUDA IMPORTA
                </span>

                <h2>
                    Pequenas ações podem gerar grandes mudanças
                </h2>

                <p>
                    Doe seu tempo, contribua com uma campanha
                    ou ajude nossas ações a chegarem a mais pessoas.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FORMAS DE AJUDAR
    ====================================================== -->

    <section class="ajudar-formas">

        <div class="container">

            <div class="home-secao-cabecalho">

                <span class="secao-etiqueta">
                    COMO PARTICIPAR
                </span>

                <h2>
                    Escolha como você deseja ajudar
                </h2>

                <p>
                    Existem diferentes maneiras de fazer parte
                    das ações do Instituto Solidarize.
                </p>

            </div>


            <div class="ajudar-cards-grid">


                <!-- VOLUNTARIADO -->

                <article class="ajudar-card">

                    <span class="ajudar-card-numero">
                        01
                    </span>

                    <span class="secao-etiqueta">
                        VOLUNTARIADO
                    </span>

                    <h3>
                        Seja voluntário
                    </h3>

                    <p>
                        Participe das nossas ações e contribua
                        com seu tempo, conhecimento e habilidades.
                    </p>

                    <div class="ajudar-card-detalhe">

                        <strong>
                            Você pode ajudar
                        </strong>

                        <p>
                            Participando de campanhas, ações sociais,
                            organização de atividades e apoio
                            à comunidade.
                        </p>

                    </div>

                    <a
                        href="/quero-ser-voluntario"
                        class="btn-principal"
                    >
                        Quero ser voluntário
                    </a>

                </article>


                <!-- DOAÇÕES -->

                <article class="ajudar-card">

                    <span class="ajudar-card-numero">
                        02
                    </span>

                    <span class="secao-etiqueta">
                        DOAÇÕES
                    </span>

                    <h3>
                        Apoie uma campanha
                    </h3>

                    <p>
                        Sua contribuição pode ajudar nossas campanhas
                        a alcançar as metas e beneficiar ainda
                        mais pessoas.
                    </p>

                    <div class="ajudar-card-detalhe">

                        <strong>
                            Como contribuir
                        </strong>

                        <p>
                            Escolha uma campanha ativa e faça sua
                            contribuição diretamente pelo site.
                        </p>

                    </div>

                    <a
                        href="/campanhas"
                        class="btn-principal"
                    >
                        Ver campanhas
                    </a>

                </article>


                <!-- DIVULGAÇÃO -->

                <article class="ajudar-card">

                    <span class="ajudar-card-numero">
                        03
                    </span>

                    <span class="secao-etiqueta">
                        DIVULGAÇÃO
                    </span>

                    <h3>
                        Compartilhe nossas ações
                    </h3>

                    <p>
                        Divulgar também é uma forma de ajudar.
                        Quanto mais pessoas conhecerem nossas ações,
                        maior poderá ser o impacto.
                    </p>

                    <div class="ajudar-card-detalhe">

                        <strong>
                            Ajude a divulgar
                        </strong>

                        <p>
                            Compartilhe nossas campanhas com amigos,
                            familiares e outras pessoas da comunidade.
                        </p>

                    </div>

                    <a
                        href="/campanhas"
                        class="btn-secundario"
                    >
                        Conhecer campanhas
                    </a>

                </article>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PASSOS
    ====================================================== -->

    <section class="ajudar-passos">

        <div class="container">

            <div class="ajudar-passos-cabecalho">

                <span class="secao-etiqueta">
                    É SIMPLES PARTICIPAR
                </span>

                <h2>
                    Da vontade de ajudar à ação
                </h2>

                <p>
                    Escolha uma forma de participar e faça parte
                    das iniciativas do Instituto Solidarize.
                </p>

            </div>


            <div class="ajudar-passos-grid">

                <div class="ajudar-passo">

                    <span>
                        01
                    </span>

                    <div>

                        <h3>
                            Escolha
                        </h3>

                        <p>
                            Encontre a forma de participação
                            que mais combina com você.
                        </p>

                    </div>

                </div>


                <div class="ajudar-passo">

                    <span>
                        02
                    </span>

                    <div>

                        <h3>
                            Participe
                        </h3>

                        <p>
                            Cadastre-se como voluntário
                            ou apoie uma de nossas campanhas.
                        </p>

                    </div>

                </div>


                <div class="ajudar-passo">

                    <span>
                        03
                    </span>

                    <div>

                        <h3>
                            Transforme
                        </h3>

                        <p>
                            Sua contribuição passa a fazer
                            parte de uma ação coletiva.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CHAMADA FINAL
    ====================================================== -->

    <section class="home-cta">

        <div class="container">

            <div class="home-cta-box">

                <span class="secao-etiqueta">
                    FAÇA PARTE
                </span>

                <h2>
                    Toda ajuda pode fazer diferença
                </h2>

                <p>
                    Escolha uma campanha, participe como voluntário
                    ou entre em contato com o Instituto Solidarize.
                </p>

                <div class="hero-botoes">

                    <a
                        href="/campanhas"
                        class="btn-principal"
                    >
                        Apoiar uma campanha
                    </a>

                    <a
                        href="/contato"
                        class="btn-secundario"
                    >
                        Falar conosco
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>