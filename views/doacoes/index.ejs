<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>
                <p class="admin-subtitulo">
                    Instituto Solidarize
                </p>

                <h1>Doações</h1>

                <p>
                    Consulte e gerencie as doações recebidas pela instituição.
                </p>
            </div>

            <a
                href="/admin/doacoes/nova"
                class="btn-principal"
            >
                + Nova doação
            </a>

        </div>


        <section class="admin-pagina-card">

            <% if (doacoes.length === 0) { %>

                <div class="admin-vazio">

                    <span>❤️</span>

                    <p>
                        Nenhuma doação cadastrada.
                    </p>

                </div>

            <% } else { %>

                <div class="tabela-container">

                    <table>

                        <thead>

                            <tr>
                                <th>ID</th>
                                <th>Doador</th>
                                <th>Tipo</th>
                                <th>Quantidade</th>
                                <th>Valor</th>
                                <th>Campanha</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>

                        </thead>


                        <tbody>

                            <% doacoes.forEach(doacao => { %>

                                <tr>

                                    <td>
                                        <%= doacao.id %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= doacao.doador_nome %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= doacao.tipo %>
                                    </td>

                                    <td>
                                        <%= doacao.quantidade || '-' %>
                                    </td>

                                    <td>

                                        <% if (doacao.valor !== null && doacao.valor !== '') { %>

                                            R$
                                            <%= Number(doacao.valor)
                                                .toFixed(2)
                                                .replace('.', ',') %>

                                        <% } else { %>

                                            -

                                        <% } %>

                                    </td>

                                    <td>
                                        <%= doacao.campanha || 'Sem campanha' %>
                                    </td>

                                    <td>
                                        <%= doacao.data_doacao_formatada %>
                                    </td>

                                    <td>

                                        <span class="status-admin">
                                            <%= doacao.status %>
                                        </span>

                                    </td>

                                    <td>

                                        <div class="acoes-tabela">

                                            <a
                                                href="/admin/doacoes/<%= doacao.id %>/editar"
                                                class="btn-editar"
                                            >
                                                Editar
                                            </a>

                                            <form
                                                action="/admin/doacoes/<%= doacao.id %>/excluir"
                                                method="POST"
                                                onsubmit="return confirm('Deseja realmente excluir esta doação?')"
                                            >

                                                <button
                                                    type="submit"
                                                    class="btn-excluir"
                                                >
                                                    Excluir
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>