<%- include('../partials/header') %>

<%- include('../partials/navbar') %>

<main class="doacao-publica-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="doacao-hero">

        <div class="container doacao-hero-grid">

            <div class="doacao-hero-conteudo">

                <span class="secao-etiqueta">
                    FAÇA A DIFERENÇA
                </span>

                <h1>
                    Sua contribuição pode
                    <span>transformar histórias</span>
                </h1>

                <p>
                    Escolha um valor, informe seus dados
                    e contribua com esta campanha do
                    Instituto Solidarize.
                </p>

            </div>


            <div class="doacao-hero-destaque">

                <span class="doacao-hero-etiqueta">
                    DOAÇÃO POR PIX
                </span>

                <h2>
                    Um processo simples para apoiar nossas ações
                </h2>

                <p>
                    Após registrar sua doação, você receberá
                    as informações para realizar o pagamento
                    por PIX.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CONTEÚDO DA DOAÇÃO
    ====================================================== -->

    <section class="doacao-publica-conteudo doacao-publica-conteudo-novo">

        <div class="container doacao-publica-grid doacao-publica-grid-novo">


            <!-- =================================================
                 CAMPANHA
            ================================================== -->

            <article class="doacao-campanha-card doacao-campanha-card-novo">


                <!-- IMAGEM -->

                <% if (campanha.imagem) { %>

                    <div class="doacao-campanha-imagem">

                        <img
                            src="/images/campanhas/<%= campanha.imagem %>"
                            alt="Imagem da campanha <%= campanha.titulo %>"
                            loading="lazy"
                        >

                    </div>

                <% } %>


                <div class="doacao-campanha-conteudo">

                    <div class="doacao-campanha-topo">

                        <span class="secao-etiqueta">
                            CAMPANHA SELECIONADA
                        </span>

                        <span class="doacao-campanha-id">
                            #<%= campanha.id %>
                        </span>

                    </div>


                    <h2>
                        <%= campanha.titulo %>
                    </h2>


                    <p class="doacao-campanha-descricao">
                        <%= campanha.descricao %>
                    </p>


                    <% if (campanha.meta) { %>

                        <div class="doacao-meta">

                            <span>
                                Meta da campanha
                            </span>

                            <strong>
                                R$
                                <%= Number(campanha.meta)
                                    .toFixed(2)
                                    .replace('.', ',') %>
                            </strong>

                        </div>

                    <% } %>


                    <% if (
                        campanha.valor_arrecadado !== undefined &&
                        campanha.meta
                    ) { %>

                        <%
                            const meta =
                                Number(campanha.meta) || 0;

                            const arrecadado =
                                Number(
                                    campanha.valor_arrecadado
                                ) || 0;

                            const percentual =
                                meta > 0
                                    ? (arrecadado / meta) * 100
                                    : 0;

                            const percentualExibido =
                                Math.round(percentual);

                            const larguraBarra =
                                Math.min(percentual, 100);
                        %>


                        <div class="campanha-arrecadacao">

                            <div class="campanha-arrecadacao-topo">

                                <span>
                                    Arrecadado
                                </span>

                                <strong>
                                    R$
                                    <%= arrecadado
                                        .toFixed(2)
                                        .replace('.', ',') %>
                                </strong>

                            </div>


                            <div
                                class="campanha-progresso"
                                role="progressbar"
                                aria-label="Progresso da arrecadação"
                                aria-valuemin="0"
                                aria-valuemax="100"
                                aria-valuenow="<%= Math.min(
                                    percentualExibido,
                                    100
                                ) %>"
                            >

                                <div
                                    class="campanha-progresso-preenchimento"
                                    style="width: <%= larguraBarra %>%"
                                ></div>

                            </div>


                            <div class="campanha-progresso-dados">

                                <span>
                                    R$
                                    <%= arrecadado
                                        .toFixed(2)
                                        .replace('.', ',') %>

                                    de R$

                                    <%= meta
                                        .toFixed(2)
                                        .replace('.', ',') %>
                                </span>

                                <strong>
                                    <%= percentualExibido %>%
                                </strong>

                            </div>

                        </div>

                    <% } %>

                </div>

            </article>


            <!-- =================================================
                 FORMULÁRIO
            ================================================== -->

            <article class="doacao-form-card doacao-form-card-novo">

                <span class="secao-etiqueta">
                    SUA CONTRIBUIÇÃO
                </span>

                <h2>
                    Escolha quanto deseja doar
                </h2>

                <p class="doacao-form-texto">
                    Informe seu nome e escolha um dos valores
                    sugeridos ou digite outro valor.
                </p>


                <% if (erro) { %>

                    <div class="mensagem erro">
                        <%= erro %>
                    </div>

                <% } %>


                <form
                    action="/doar/<%= campanha.id %>"
                    method="POST"
                    class="formulario doacao-formulario"
                >


                    <!-- NOME -->

                    <div class="campo">

                        <label for="doador_nome">
                            Seu nome
                        </label>

                        <input
                            type="text"
                            id="doador_nome"
                            name="doador_nome"
                            maxlength="150"
                            value="<%= dados.doador_nome || '' %>"
                            placeholder="Digite seu nome"
                            autocomplete="name"
                            required
                        >

                    </div>


                    <!-- VALORES SUGERIDOS -->

                    <div class="campo">

                        <label>
                            Sugestões de valor
                        </label>

                        <div class="doacao-valores">

                            <button
                                type="button"
                                data-valor-doacao="10"
                            >
                                R$ 10
                            </button>

                            <button
                                type="button"
                                data-valor-doacao="25"
                            >
                                R$ 25
                            </button>

                            <button
                                type="button"
                                data-valor-doacao="50"
                            >
                                R$ 50
                            </button>

                            <button
                                type="button"
                                data-valor-doacao="100"
                            >
                                R$ 100
                            </button>

                        </div>

                    </div>


                    <!-- VALOR -->

                    <div class="campo">

                        <label for="valor">
                            Valor da doação
                        </label>

                        <div class="doacao-valor-input">

                            <span>
                                R$
                            </span>

                            <input
                                type="number"
                                id="valor"
                                name="valor"
                                min="1"
                                max="1000000"
                                step="0.01"
                                value="<%= dados.valor || '' %>"
                                placeholder="0,00"
                                required
                            >

                        </div>

                    </div>


                    <!-- BOTÃO -->

                    <button
                        type="submit"
                        class="btn-principal doacao-btn"
                    >
                        Continuar para pagamento
                    </button>

                </form>


                <!-- INFORMAÇÃO -->

                <div class="doacao-aviso">

                    <span>
                        COMO FUNCIONA
                    </span>

                    <p>
                        Sua doação será registrada inicialmente
                        como pendente. Depois do pagamento por PIX,
                        a equipe do Instituto poderá confirmar
                        o recebimento.
                    </p>

                </div>

            </article>

        </div>

    </section>


    <!-- =====================================================
         ETAPAS
    ====================================================== -->

    <section class="doacao-etapas">

        <div class="container">

            <div class="doacao-etapas-cabecalho">

                <span class="secao-etiqueta">
                    PASSO A PASSO
                </span>

                <h2>
                    Como sua doação é realizada
                </h2>

            </div>


            <div class="doacao-etapas-grid">

                <div class="doacao-etapa">

                    <span>
                        01
                    </span>

                    <div>

                        <h3>
                            Escolha o valor
                        </h3>

                        <p>
                            Informe quanto deseja contribuir
                            com a campanha.
                        </p>

                    </div>

                </div>


                <div class="doacao-etapa">

                    <span>
                        02
                    </span>

                    <div>

                        <h3>
                            Receba o PIX
                        </h3>

                        <p>
                            Após continuar, você verá os dados
                            necessários para realizar o pagamento.
                        </p>

                    </div>

                </div>


                <div class="doacao-etapa">

                    <span>
                        03
                    </span>

                    <div>

                        <h3>
                            Envie o comprovante
                        </h3>

                        <p>
                            Depois do pagamento, envie o comprovante
                            pelo WhatsApp do Instituto.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('../partials/footer') %>