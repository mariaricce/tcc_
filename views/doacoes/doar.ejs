<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="doacao-publica-page">

    <section class="pagina-topo">

        <div class="container">

            <span class="secao-etiqueta">
                FAÇA A DIFERENÇA
            </span>

            <h1>
                Faça uma doação
            </h1>

            <p>
                Sua contribuição ajuda o Instituto Solidarize
                a continuar realizando suas ações.
            </p>

        </div>

    </section>


    <section class="doacao-publica-conteudo">

        <div class="container doacao-publica-grid">


            <!-- CAMPANHA -->

            <div class="doacao-campanha-card">


                <!-- IMAGEM DA CAMPANHA -->

                <% if (campanha.imagem) { %>

                    <div class="doacao-campanha-imagem">

                        <img
                            src="/images/campanhas/<%= campanha.imagem %>"
                            alt="Imagem da campanha <%= campanha.titulo %>"
                            loading="lazy"
                        >

                    </div>

                <% } %>


                <span class="secao-etiqueta">
                    CAMPANHA
                </span>


                <h2>
                    <%= campanha.titulo %>
                </h2>


                <p>
                    <%= campanha.descricao %>
                </p>


                <% if (campanha.meta) { %>

                    <div class="doacao-meta">

                        <span>
                            Meta da campanha
                        </span>

                        <strong>
                            R$
                            <%= Number(campanha.meta)
                                .toFixed(2)
                                .replace('.', ',') %>
                        </strong>

                    </div>

                <% } %>


                <% if (
                    campanha.valor_arrecadado !== undefined &&
                    campanha.meta
                ) { %>

                    <%
                        const meta =
                            Number(campanha.meta) || 0;

                        const arrecadado =
                            Number(
                                campanha.valor_arrecadado
                            ) || 0;

                        const percentual =
                            meta > 0
                                ? (arrecadado / meta) * 100
                                : 0;

                        const percentualExibido =
                            Math.round(percentual);

                        const larguraBarra =
                            Math.min(percentual, 100);
                    %>


                    <div class="campanha-arrecadacao">

                        <div class="campanha-arrecadacao-topo">

                            <span>
                                Arrecadado
                            </span>

                            <strong>
                                R$
                                <%= arrecadado
                                    .toFixed(2)
                                    .replace('.', ',') %>
                            </strong>

                        </div>


                        <div
                            class="campanha-progresso"
                            role="progressbar"
                            aria-label="Progresso da arrecadação"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-valuenow="<%= Math.min(
                                percentualExibido,
                                100
                            ) %>"
                        >

                            <div
                                class="campanha-progresso-preenchimento"
                                style="width: <%= larguraBarra %>%"
                            ></div>

                        </div>


                        <div class="campanha-progresso-dados">

                            <span>
                                R$
                                <%= arrecadado
                                    .toFixed(2)
                                    .replace('.', ',') %>

                                de R$

                                <%= meta
                                    .toFixed(2)
                                    .replace('.', ',') %>
                            </span>

                            <strong>
                                <%= percentualExibido %>%
                            </strong>

                        </div>

                    </div>

                <% } %>

            </div>


            <!-- FORMULÁRIO DE DOAÇÃO -->

            <div class="doacao-form-card">

                <span class="secao-etiqueta">
                    DOAÇÃO EM DINHEIRO
                </span>

                <h2>
                    Escolha quanto deseja doar
                </h2>

                <p class="doacao-form-texto">
                    Após confirmar os dados, você receberá
                    as informações para realizar o pagamento por PIX.
                </p>


                <% if (erro) { %>

                    <div class="mensagem erro">
                        <%= erro %>
                    </div>

                <% } %>


                <form
                    action="/doar/<%= campanha.id %>"
                    method="POST"
                    class="formulario doacao-formulario"
                >


                    <div class="campo">

                        <label for="doador_nome">
                            Seu nome
                        </label>

                        <input
                            type="text"
                            id="doador_nome"
                            name="doador_nome"
                            maxlength="150"
                            value="<%= dados.doador_nome || '' %>"
                            placeholder="Digite seu nome"
                            required
                        >

                    </div>


                    <div class="campo">

                        <label>
                            Sugestões de valor
                        </label>


                        <div class="doacao-valores">

                            <button
                                type="button"
                                data-valor-doacao="10"
                            >
                                R$ 10
                            </button>

                            <button
                                type="button"
                                data-valor-doacao="25"
                            >
                                R$ 25
                            </button>

                            <button
                                type="button"
                                data-valor-doacao="50"
                            >
                                R$ 50
                            </button>

                            <button
                                type="button"
                                data-valor-doacao="100"
                            >
                                R$ 100
                            </button>

                        </div>

                    </div>


                    <div class="campo">

                        <label for="valor">
                            Valor da doação
                        </label>


                        <div class="doacao-valor-input">

                            <span>
                                R$
                            </span>

                            <input
                                type="number"
                                id="valor"
                                name="valor"
                                min="1"
                                max="1000000"
                                step="0.01"
                                value="<%= dados.valor || '' %>"
                                placeholder="0,00"
                                required
                            >

                        </div>

                    </div>


                    <button
                        type="submit"
                        class="btn-principal doacao-btn"
                    >
                        Continuar para pagamento
                    </button>

                </form>


                <p class="doacao-seguranca">
                    A doação será registrada inicialmente como
                    pendente e será confirmada após a conferência
                    do pagamento.
                </p>

            </div>

        </div>

    </section>

</main>

<%- include('../partials/footer') %>