<%- include('../partials/header') %>

<div class="admin-layout">

    <%- include('../partials/admin-sidebar') %>

    <main class="admin-conteudo">

        <div class="admin-cabecalho">

            <div>

                <p class="admin-subtitulo">
                    Doações
                </p>

                <h1>Nova Doação</h1>

                <p>
                    Registre uma nova doação recebida pelo Instituto Solidarize.
                </p>

            </div>

            <a
                href="/admin/doacoes"
                class="btn-secundario"
            >
                ← Voltar
            </a>

        </div>


        <section class="admin-form-card">

            <% if (typeof erro !== 'undefined' && erro) { %>

                <div class="mensagem erro">
                    <%= erro %>
                </div>

            <% } %>


            <form
                action="/admin/doacoes/nova"
                method="POST"
                class="formulario admin-formulario"
            >

                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="doador_nome">
                            Nome do doador *
                        </label>

                        <input
                            type="text"
                            id="doador_nome"
                            name="doador_nome"
                            placeholder="Nome da pessoa ou empresa"
                            required
                        >

                    </div>


                    <div class="campo">

                        <label for="tipo">
                            Tipo de doação *
                        </label>

                        <select
                            id="tipo"
                            name="tipo"
                            required
                        >

                            <option value="">
                                Selecione
                            </option>

                            <option value="Dinheiro">
                                Dinheiro
                            </option>

                            <option value="Alimentos">
                                Alimentos
                            </option>

                            <option value="Roupas">
                                Roupas
                            </option>

                            <option value="Material escolar">
                                Material escolar
                            </option>

                            <option value="Higiene">
                                Higiene
                            </option>

                            <option value="Outros">
                                Outros
                            </option>

                        </select>

                    </div>

                </div>


                <div class="campo">

                    <label for="descricao">
                        Descrição
                    </label>

                    <textarea
                        id="descricao"
                        name="descricao"
                        rows="4"
                        placeholder="Descreva os itens ou detalhes da doação"
                    ></textarea>

                </div>


                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="quantidade">
                            Quantidade
                        </label>

                        <input
                            type="number"
                            id="quantidade"
                            name="quantidade"
                            min="1"
                            placeholder="Ex.: 10"
                        >

                    </div>


                    <div class="campo">

                        <label for="valor">
                            Valor em R$
                        </label>

                        <input
                            type="number"
                            id="valor"
                            name="valor"
                            min="0"
                            step="0.01"
                            placeholder="0,00"
                        >

                    </div>

                </div>


                <div class="admin-form-grid">

                    <div class="campo">

                        <label for="data_doacao">
                            Data da doação *
                        </label>

                        <input
                            type="date"
                            id="data_doacao"
                            name="data_doacao"
                            required
                        >

                    </div>


                    <div class="campo">

                        <label for="campanha_id">
                            Campanha
                        </label>

                        <select
                            id="campanha_id"
                            name="campanha_id"
                        >

                            <option value="">
                                Sem campanha específica
                            </option>

                            <% campanhas.forEach(campanha => { %>

                                <option value="<%= campanha.id %>">
                                    <%= campanha.titulo %>
                                </option>

                            <% }) %>

                        </select>

                    </div>

                </div>


                <div class="campo">

                    <label for="status">
                        Status *
                    </label>

                    <select
                        id="status"
                        name="status"
                        required
                    >

                        <option value="Recebida">
                            Recebida
                        </option>

                        <option value="Pendente">
                            Pendente
                        </option>

                        <option value="Cancelada">
                            Cancelada
                        </option>

                    </select>

                </div>


                <div class="admin-form-acoes">

                    <a
                        href="/admin/doacoes"
                        class="btn-secundario"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn-principal"
                    >
                        Registrar doação
                    </button>

                </div>

            </form>

        </section>

    </main>

</div>

</body>
</html>