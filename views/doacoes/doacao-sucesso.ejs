<%- include('../partials/header') %>

<%- include('../partials/navbar') %>

<main class="doacao-sucesso-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="doacao-sucesso-hero">

        <div class="container doacao-sucesso-hero-grid">

            <div class="doacao-sucesso-hero-conteudo">

                <span class="secao-etiqueta">
                    DOAÇÃO REGISTRADA
                </span>

                <h1>
                    Falta apenas realizar
                    <span>o PIX</span>
                </h1>

                <p>
                    Sua intenção de doação já foi registrada
                    no Instituto Solidarize. Agora siga as
                    instruções para concluir sua contribuição.
                </p>

            </div>


            <div class="doacao-sucesso-hero-destaque">

                <span class="doacao-sucesso-hero-etiqueta">
                    PRÓXIMO PASSO
                </span>

                <h2>
                    Realize o pagamento e envie o comprovante
                </h2>

                <p>
                    A doação permanecerá como pendente até
                    que o pagamento seja conferido pela equipe
                    do Instituto.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <section class="doacao-sucesso-conteudo doacao-sucesso-conteudo-novo">

        <div class="container">

            <div class="doacao-sucesso-card doacao-sucesso-card-novo">


                <!-- =================================================
                     RESUMO DA DOAÇÃO
                ================================================== -->

                <div class="doacao-resumo doacao-resumo-novo">


                    <% if (doacao.campanha_imagem) { %>

                        <div class="doacao-sucesso-imagem">

                            <img
                                src="/images/campanhas/<%= doacao.campanha_imagem %>"
                                alt="Imagem da campanha <%= doacao.campanha %>"
                                loading="lazy"
                            >

                        </div>

                    <% } %>


                    <div class="doacao-resumo-topo">

                        <span class="secao-etiqueta">
                            RESUMO
                        </span>

                        <span class="doacao-numero">
                            Doação #<%= doacao.id %>
                        </span>

                    </div>


                    <h2>
                        <%= doacao.campanha || 'Instituto Solidarize' %>
                    </h2>


                    <p class="doacao-resumo-texto">
                        Confira os dados registrados antes de
                        realizar o pagamento.
                    </p>


                    <div class="doacao-resumo-dados">

                        <div class="doacao-resumo-linha">

                            <span>
                                Doador
                            </span>

                            <strong>
                                <%= doacao.doador_nome %>
                            </strong>

                        </div>


                        <div class="doacao-resumo-linha">

                            <span>
                                Valor
                            </span>

                            <strong class="doacao-valor-destaque">
                                R$
                                <%= Number(doacao.valor)
                                    .toFixed(2)
                                    .replace('.', ',') %>
                            </strong>

                        </div>


                        <div class="doacao-resumo-linha">

                            <span>
                                Data
                            </span>

                            <strong>
                                <%= doacao.data_doacao_formatada %>
                            </strong>

                        </div>


                        <div class="doacao-resumo-linha">

                            <span>
                                Status
                            </span>

                            <strong class="doacao-status-pendente">
                                <%= doacao.status %>
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PIX
                ================================================== -->

                <div class="pix-area pix-area-nova">

                    <span class="secao-etiqueta">
                        PAGAMENTO VIA PIX
                    </span>

                    <h2>
                        Realize o pagamento
                    </h2>


                    <% if (pixChave) { %>

                        <p class="pix-introducao">
                            Utilize os dados abaixo para realizar
                            o pagamento no aplicativo do seu banco.
                        </p>


                        <!-- VALOR -->

                        <div class="pix-valor-destaque">

                            <span>
                                Valor da doação
                            </span>

                            <strong>
                                R$
                                <%= Number(doacao.valor)
                                    .toFixed(2)
                                    .replace('.', ',') %>
                            </strong>

                        </div>


                        <!-- RECEBEDOR -->

                        <div class="pix-recebedor">

                            <span>
                                Recebedor
                            </span>

                            <strong>
                                <%= pixRecebedor %>
                            </strong>

                        </div>


                        <!-- CHAVE -->

                        <div class="pix-chave-box">

                            <span>
                                Chave PIX
                            </span>

                            <strong id="pix-chave">
                                <%= pixChave %>
                            </strong>

                            <button
                                type="button"
                                id="copiar-pix"
                                class="btn-secundario pix-copiar-btn"
                            >
                                Copiar chave PIX
                            </button>

                        </div>


                        <p
                            id="pix-copiado"
                            class="pix-copiado"
                            hidden
                        >
                            Chave PIX copiada.
                        </p>


                        <!-- ORIENTAÇÃO -->

                        <div class="pix-orientacao-box">

                            <span>
                                DEPOIS DO PAGAMENTO
                            </span>

                            <p>
                                Envie o comprovante pelo WhatsApp
                                do Instituto para que a equipe possa
                                conferir e confirmar sua doação.
                            </p>

                        </div>


                        <a
                            href="<%= whatsappLink %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-principal doacao-whatsapp"
                        >
                            Enviar comprovante pelo WhatsApp
                        </a>


                    <% } else { %>

                        <div class="mensagem erro">
                            A chave PIX ainda não foi
                            configurada no sistema.
                        </div>


                        <a
                            href="<%= whatsappLink %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-principal doacao-whatsapp"
                        >
                            Falar com o Instituto
                        </a>

                    <% } %>


                    <a
                        href="/campanhas"
                        class="doacao-voltar"
                    >
                        Voltar para campanhas
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         ETAPAS FINAIS
    ====================================================== -->

    <section class="doacao-sucesso-etapas">

        <div class="container">

            <div class="doacao-sucesso-etapas-cabecalho">

                <span class="secao-etiqueta">
                    PARA FINALIZAR
                </span>

                <h2>
                    Sua doação está quase concluída
                </h2>

                <p>
                    Siga estes passos para que a equipe
                    consiga confirmar sua contribuição.
                </p>

            </div>


            <div class="doacao-sucesso-etapas-grid">

                <div class="doacao-sucesso-etapa">

                    <span>
                        01
                    </span>

                    <div>

                        <h3>
                            Faça o PIX
                        </h3>

                        <p>
                            Utilize a chave informada nesta página
                            para realizar o pagamento.
                        </p>

                    </div>

                </div>


                <div class="doacao-sucesso-etapa">

                    <span>
                        02
                    </span>

                    <div>

                        <h3>
                            Envie o comprovante
                        </h3>

                        <p>
                            Use o botão do WhatsApp para encaminhar
                            o comprovante ao Instituto.
                        </p>

                    </div>

                </div>


                <div class="doacao-sucesso-etapa">

                    <span>
                        03
                    </span>

                    <div>

                        <h3>
                            Aguarde a confirmação
                        </h3>

                        <p>
                            Após a conferência, a doação poderá
                            ser marcada como recebida pela equipe.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('../partials/footer') %>