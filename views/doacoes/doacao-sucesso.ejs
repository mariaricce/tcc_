<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="doacao-sucesso-page">

    <section class="pagina-topo">

        <div class="container">

            <span class="secao-etiqueta">
                DOAÇÃO REGISTRADA
            </span>

            <h1>
                Falta apenas realizar o PIX
            </h1>

            <p>
                Sua intenção de doação já foi registrada
                no Instituto Solidarize.
            </p>

        </div>

    </section>


    <section class="doacao-sucesso-conteudo">

        <div class="container">

            <div class="doacao-sucesso-card">


                <!-- RESUMO DA DOAÇÃO -->

                <div class="doacao-resumo">


                    <% if (doacao.campanha_imagem) { %>

                        <div class="doacao-sucesso-imagem">

                            <img
                                src="/images/campanhas/<%= doacao.campanha_imagem %>"
                                alt="Imagem da campanha <%= doacao.campanha %>"
                            >

                        </div>

                    <% } %>


                    <span>
                        Doação #<%= doacao.id %>
                    </span>


                    <h2>
                        <%= doacao.campanha || 'Instituto Solidarize' %>
                    </h2>


                    <div class="doacao-resumo-linha">

                        <span>
                            Doador
                        </span>

                        <strong>
                            <%= doacao.doador_nome %>
                        </strong>

                    </div>


                    <div class="doacao-resumo-linha">

                        <span>
                            Valor
                        </span>

                        <strong class="doacao-valor-destaque">

                            R$
                            <%= Number(doacao.valor)
                                .toFixed(2)
                                .replace('.', ',') %>

                        </strong>

                    </div>


                    <div class="doacao-resumo-linha">

                        <span>
                            Data
                        </span>

                        <strong>
                            <%= doacao.data_doacao_formatada %>
                        </strong>

                    </div>


                    <div class="doacao-resumo-linha">

                        <span>
                            Status
                        </span>

                        <strong>
                            <%= doacao.status %>
                        </strong>

                    </div>

                </div>


                <!-- PAGAMENTO PIX -->

                <div class="pix-area">

                    <span class="secao-etiqueta">
                        PAGAMENTO VIA PIX
                    </span>

                    <h2>
                        Realize o pagamento
                    </h2>


                    <% if (pixChave) { %>

                        <p>
                            Envie o valor da doação para a chave PIX abaixo:
                        </p>


                        <div class="pix-recebedor">

                            <span>
                                Recebedor
                            </span>

                            <strong>
                                <%= pixRecebedor %>
                            </strong>

                        </div>


                        <div class="pix-chave-box">

                            <span>
                                Chave PIX
                            </span>

                            <strong id="pix-chave">
                                <%= pixChave %>
                            </strong>


                            <button
                                type="button"
                                id="copiar-pix"
                                class="btn-secundario"
                            >
                                Copiar chave PIX
                            </button>

                        </div>


                        <p
                            id="pix-copiado"
                            class="pix-copiado"
                            hidden
                        >
                            Chave PIX copiada.
                        </p>


                        <p class="pix-orientacao">
                            Após realizar o pagamento,
                            envie o comprovante pelo WhatsApp
                            para que a doação possa ser confirmada.
                        </p>


                        <a
                            href="<%= whatsappLink %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-principal doacao-whatsapp"
                        >
                            Enviar comprovante pelo WhatsApp
                        </a>


                    <% } else { %>

                        <div class="mensagem erro">

                            A chave PIX ainda não foi
                            configurada no sistema.

                        </div>


                        <a
                            href="<%= whatsappLink %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-principal doacao-whatsapp"
                        >
                            Falar com o Instituto
                        </a>

                    <% } %>


                    <a
                        href="/campanhas"
                        class="doacao-voltar"
                    >
                        Voltar para campanhas
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<%- include('../partials/footer') %>