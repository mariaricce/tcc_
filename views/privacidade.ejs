<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main>

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="privacidade-hero">

        <div class="container privacidade-hero-grid">

            <div class="privacidade-hero-conteudo">

                <span class="secao-etiqueta">
                    PRIVACIDADE
                </span>

                <h1>
                    Transparência sobre seus
                    <span>dados e preferências</span>
                </h1>

                <p>
                    Conheça de forma simples como o site
                    do Instituto Solidarize utiliza as informações
                    fornecidas pelos usuários e os recursos
                    necessários para seu funcionamento.
                </p>

            </div>


            <div class="privacidade-hero-card">

                <span>
                    INSTITUTO SOLIDARIZE
                </span>

                <strong>
                    Privacidade faz parte de uma experiência responsável.
                </strong>

                <p>
                    Utilizamos apenas os dados necessários
                    para oferecer os recursos disponíveis
                    no site e facilitar o contato com o Instituto.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         INTRODUÇÃO
    ====================================================== -->

    <section class="privacidade-introducao">

        <div class="container">

            <div class="privacidade-introducao-grid">

                <div>

                    <span class="secao-etiqueta">
                        SOBRE ESTA PÁGINA
                    </span>

                    <h2>
                        Como suas informações são utilizadas
                    </h2>

                </div>


                <p>
                    Esta página apresenta as principais informações
                    sobre o tratamento de dados realizado dentro
                    das funcionalidades atualmente disponíveis
                    no site do Instituto Solidarize.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <section class="privacidade-conteudo-novo">

        <div class="container privacidade-conteudo-grid">


            <!-- =================================================
                 COLUNA PRINCIPAL
            ================================================== -->

            <div class="privacidade-blocos">


                <!-- DADOS -->

                <article class="privacidade-bloco">

                    <div class="privacidade-bloco-numero">
                        01
                    </div>

                    <div>

                        <h2>
                            Dados fornecidos pelo usuário
                        </h2>

                        <p>
                            Algumas funcionalidades do site solicitam
                            informações fornecidas voluntariamente
                            pelo próprio usuário.
                        </p>

                        <p>
                            Esses dados podem incluir nome, e-mail,
                            telefone, informações de cadastro,
                            interesse em voluntariado e informações
                            relacionadas às doações realizadas
                            pelo site.
                        </p>

                    </div>

                </article>


                <!-- CADASTRO -->

                <article class="privacidade-bloco">

                    <div class="privacidade-bloco-numero">
                        02
                    </div>

                    <div>

                        <h2>
                            Cadastro e acesso à conta
                        </h2>

                        <p>
                            Quando uma conta é criada, informações
                            como nome e e-mail são utilizadas
                            para identificação do usuário
                            dentro do sistema.
                        </p>

                        <p>
                            As senhas não são armazenadas em texto
                            simples. O sistema utiliza hash de senha
                            para aumentar a proteção das credenciais
                            cadastradas.
                        </p>

                    </div>

                </article>


                <!-- VOLUNTARIADO -->

                <article class="privacidade-bloco">

                    <div class="privacidade-bloco-numero">
                        03
                    </div>

                    <div>

                        <h2>
                            Cadastro de voluntários
                        </h2>

                        <p>
                            O formulário de voluntariado permite
                            o envio de informações como nome,
                            e-mail, telefone, área de interesse
                            e disponibilidade.
                        </p>

                        <p>
                            Esses dados são utilizados para organizar
                            os cadastros de pessoas interessadas
                            em participar das atividades
                            do Instituto Solidarize.
                        </p>

                    </div>

                </article>


                <!-- CONTATO -->

                <article class="privacidade-bloco">

                    <div class="privacidade-bloco-numero">
                        04
                    </div>

                    <div>

                        <h2>
                            Formulário de contato
                        </h2>

                        <p>
                            As informações enviadas pela página
                            de contato são utilizadas para possibilitar
                            a comunicação entre o visitante
                            e o Instituto Solidarize.
                        </p>

                        <p>
                            As mensagens são encaminhadas
                            ao endereço eletrônico utilizado
                            pelo Instituto para atendimento.
                        </p>

                    </div>

                </article>


                <!-- COOKIES -->

                <article class="privacidade-bloco">

                    <div class="privacidade-bloco-numero">
                        05
                    </div>

                    <div>

                        <h2>
                            Cookies e armazenamento no navegador
                        </h2>

                        <p>
                            O sistema utiliza uma sessão necessária
                            para manter usuários autenticados
                            durante o acesso às áreas permitidas
                            do site.
                        </p>

                        <p>
                            O navegador também pode armazenar
                            algumas preferências locais,
                            como a escolha entre modo claro
                            e modo escuro.
                        </p>

                        <p>
                            A confirmação do aviso de cookies
                            é armazenada apenas durante
                            a sessão atual do navegador.
                        </p>

                    </div>

                </article>


                <!-- SEGURANÇA -->

                <article class="privacidade-bloco">

                    <div class="privacidade-bloco-numero">
                        06
                    </div>

                    <div>

                        <h2>
                            Segurança das informações
                        </h2>

                        <p>
                            O Instituto Solidarize utiliza mecanismos
                            de autenticação, controle de sessão
                            e proteção das senhas cadastradas
                            para auxiliar na segurança das contas.
                        </p>

                        <p>
                            O acesso às funcionalidades administrativas
                            é restrito aos usuários autorizados
                            pelo sistema.
                        </p>

                    </div>

                </article>

            </div>


            <!-- =================================================
                 LATERAL
            ================================================== -->

            <aside class="privacidade-lateral">

                <div class="privacidade-lateral-card">

                    <span class="secao-etiqueta">
                        RESUMO
                    </span>

                    <h2>
                        O que utilizamos
                    </h2>

                    <p>
                        Os recursos de armazenamento utilizados
                        atualmente têm relação direta com
                        o funcionamento do sistema.
                    </p>


                    <div class="privacidade-lateral-item">

                        <span>
                            01
                        </span>

                        <div>

                            <strong>
                                Sessão
                            </strong>

                            <p>
                                Mantém o acesso do usuário
                                autenticado ao sistema.
                            </p>

                        </div>

                    </div>


                    <div class="privacidade-lateral-item">

                        <span>
                            02
                        </span>

                        <div>

                            <strong>
                                Preferência de tema
                            </strong>

                            <p>
                                Guarda a escolha entre
                                modo claro e escuro.
                            </p>

                        </div>

                    </div>


                    <div class="privacidade-lateral-item">

                        <span>
                            03
                        </span>

                        <div>

                            <strong>
                                Aviso de cookies
                            </strong>

                            <p>
                                Guarda temporariamente
                                a confirmação do aviso
                                durante a sessão.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="privacidade-contato-card">

                    <span>
                        PRECISA FALAR CONOSCO?
                    </span>

                    <strong>
                        Entre em contato
                    </strong>

                    <p>
                        Caso tenha alguma dúvida sobre
                        o funcionamento do site ou sobre
                        as informações fornecidas,
                        utilize nossa página de contato.
                    </p>

                    <a
                        href="/contato"
                        class="btn-principal"
                    >
                        Ir para contato
                    </a>

                </div>

            </aside>

        </div>

    </section>


    <!-- =====================================================
         INFORMAÇÕES FINAIS
    ====================================================== -->

    <section class="privacidade-final">

        <div class="container">

            <div class="privacidade-final-box">

                <div>

                    <span class="secao-etiqueta">
                        ATUALIZAÇÕES
                    </span>

                    <h2>
                        Esta página pode ser atualizada
                    </h2>

                    <p>
                        Caso novas funcionalidades sejam adicionadas
                        ao Instituto Solidarize, estas informações
                        poderão ser atualizadas para refletir
                        o funcionamento atual do sistema.
                    </p>

                </div>


                <span class="privacidade-atualizacao">
                    Atualizado em setembro de 2026
                </span>

            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>